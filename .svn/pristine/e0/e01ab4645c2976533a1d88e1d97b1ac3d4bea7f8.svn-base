#include "VulkanShader.h"

Slang::ComPtr<slang::IGlobalSession> SLANG_GLOBAL_SESSION = nullptr;


Shader_VK fShader_vk::Load(const vk::raii::Device &logicalDevice, const char *slangPath)
{    
    std::string fileName  = tFile::GetNameWithoutExtension(slangPath);
    std::string spirvPath = SHADER_COMPILED_SPIRV_DEFAULT_PATH + fileName + ".spv";
       
    // @note Check if the spirv compilation already exits
    //
    if (tFile::Exists(spirvPath.data()))
    {
        Shader_VK precompiled = Internal::LoadPrecompiledShaderAndItsPSMB(logicalDevice, spirvPath.data());
        
        // @note This means that the spirv and the slang shaders don't match. A recompilation is needed
        //
        if (precompiled.module != nullptr) { return precompiled; }
    }    

    // @note Regular shader compilation
    //
    Shader_VK shader;
	bool success = fSlang::CompileAndWriteShaderToFile(logicalDevice, slangPath, spirvPath.data(), shader);             // Compile And write Shader spirv to file                      
    if (!success) { return Internal::LoadPrecompiledShaderAndItsPSMB(logicalDevice, BAD_COMPILATION_SPIRV_PATH); }      // If the shader compilation fails, a copy of the 'bad_compilation' shader will be returned
    Internal::WritePSMBToFile(fileName.data(), shader);                                                                 // Write .spmb file from the shader

    return shader;    
} 

void fShader_vk::Destroy(Shader_VK shader)
{
    shader.module.clear();
    if (shader.entryPointsCount   > 0) { free(shader.entryPoints);    }
    if (shader.uniformCount       > 0) { free(shader.uniformOffsets); }
    if (shader.pushConstantsCount > 0) { free(shader.pushConstants);  }
}

//====================================================================================================================//

Shader_VK fShader_vk::Internal::Create(const vk::raii::Device &logicalDevice, const char *slangPath, const uint32_t entryPointsCount, const uint32_t offsetsCount, const uint32_t rangeTypesCount, std::vector<char> &shaderSpirVBuffer)
{
    Shader_VK shader
    {
        .path                            = "",
        .lastModifiedTime                = tFile::LastModifiedTime(slangPath),
        
        .entryPoints                     = (vk::ShaderStageFlagBits *)malloc(sizeof(vk::ShaderStageFlagBits) * entryPointsCount),
        .entryPointsCount                = entryPointsCount,

        .uniformOffsets                  = (UniformOffset *)malloc(sizeof(UniformOffset) * offsetsCount),
        .uniformCount                    = offsetsCount,
        .uniformRequiredBufferSize       = 0,

        .pushConstants                   = (PushConstant *)(malloc(sizeof(PushConstant) * rangeTypesCount)),
        .pushConstantsCount              = rangeTypesCount,
        .pushConstantsRequiredBufferSize = 0,


        .module                          = CreateShaderModule(logicalDevice, shaderSpirVBuffer),
    };

    strcpy(shader.path, slangPath);

    
    for (size_t i = 0; i < entryPointsCount; i++) 
    {
        shader.entryPoints[i] = vk::ShaderStageFlagBits::eMissKHR; 
    }
    
    for (size_t i = 0; i < offsetsCount; i++)
    {
        shader.uniformOffsets[i].offset      = 0;
        shader.uniformOffsets[i].shaderStage = vk::ShaderStageFlagBits::eMissKHR;
    }

    for (size_t i = 0; i < rangeTypesCount; i++) 
    {
        shader.pushConstants[i].range.offset = 0;
        shader.pushConstants[i].range.size   = 0;
        shader.pushConstants[i].rangeTypesCount  = 0;
    }



    return shader;
}

//====================================================================================================================//

vk::raii::ShaderModule fShader_vk::Internal::CreateShaderModule(const vk::raii::Device &logicalDevice, std::vector<char> &shaderBuffer)
{
	vk::ShaderModuleCreateInfo createInfo
	{
		.codeSize = (uint32_t)shaderBuffer.size(),
		.pCode    = reinterpret_cast<uint32_t *>(shaderBuffer.data())
	};

	return { logicalDevice, createInfo };
}

//====================================================================================================================//

void fShader_vk::Internal::WritePSMBToFile(const char *fileName, Shader_VK &shader)
{
    std::string filePath = SHADER_COMPILED_PSMB_DEFAULT_PATH; filePath += fileName; filePath += ".psmb";
    std::ofstream file(filePath, std::ios::binary);

    const auto now         = std::chrono::system_clock::now();
    const std::time_t time = std::chrono::system_clock::to_time_t(now);

    const char *date = std::ctime(&time);
    int length       = strlen(std::ctime(&time));

    file.write(reinterpret_cast<char *>(&length), sizeof(uint32_t));
    file.write(date, length);

    file.write(reinterpret_cast<char *>(&shader.lastModifiedTime), sizeof(long long));


    file.write(reinterpret_cast<char *>(&shader.entryPointsCount), sizeof(uint32_t));
    for (unsigned int i = 0; i < shader.entryPointsCount; i++)
    {
        file.write(reinterpret_cast<char *>(&shader.entryPoints[i]), sizeof(vk::ShaderStageFlagBits));
    }


    file.write(reinterpret_cast<char *>(&shader.uniformCount), sizeof(uint32_t));   
    for (unsigned int i = 0; i < shader.uniformCount; i++)
    {
        file.write(reinterpret_cast<char *>(&shader.uniformOffsets[i]), sizeof(UniformOffset));
    }

    file.write(reinterpret_cast<char *>(&shader.uniformRequiredBufferSize), sizeof(uint32_t));



    file.write(reinterpret_cast<char *>(&shader.pushConstantsCount), sizeof(uint32_t));
    for (size_t i = 0; i < shader.pushConstantsCount; i++)
    {
        file.write(reinterpret_cast<char *>(&shader.pushConstants[i]), sizeof(PushConstant));
    }

    file.write(reinterpret_cast<char *>(&shader.pushConstantsRequiredBufferSize), sizeof(uint32_t));

    file.close();    
}

Shader_VK fShader_vk::Internal::LoadPrecompiledShaderAndItsPSMB(const vk::raii::Device &logicalDevice, const char *spirvPath)
{
    std::string name     = tFile::GetNameWithoutExtension(spirvPath);

    std::string slangPath = SHADER_SLANG_DEFAULT_PATH + name + ".slang";
    std::string spmbPath  = SHADER_COMPILED_PSMB_DEFAULT_PATH + name + ".psmb";
    std::ifstream file(spmbPath, std::ios::binary);

    std::vector<char> shaderBuffer = bFile::LoadSpirVShader(spirvPath);
    long long slanglwt             = tFile::LastModifiedTime(slangPath.data());

    char *date    = bFile::ReadString(file);
    long long lwt = bFile::ReadSizeOf<long long>(file);

    if (slanglwt != lwt) { return Shader_VK{ }; }

    uint32_t entryPointCount             = bFile::ReadSizeOf<uint32_t>(file);
    vk::ShaderStageFlagBits *entryPoints = (vk::ShaderStageFlagBits *)malloc(sizeof(vk::ShaderStageFlagBits) * entryPointCount);
    for (unsigned int i = 0; i < entryPointCount; i++) { entryPoints[i] = bFile::ReadSizeOf<vk::ShaderStageFlagBits>(file); }
           
    uint32_t uniformCount   = bFile::ReadSizeOf<uint32_t>(file);
    UniformOffset *uniforms = (UniformOffset *)(malloc(sizeof(UniformOffset) * uniformCount));
    for (unsigned int i = 0; i < uniformCount; i++) { uniforms[i] = bFile::ReadSizeOf<UniformOffset>(file); }    

    uint32_t uniformRequiredBufferSize = bFile::ReadInt(file);

    uint32_t pushConstCount = bFile::ReadSizeOf<uint32_t>(file);
    PushConstant *pushConst = (PushConstant *)(malloc(sizeof(PushConstant) * pushConstCount));
    for (unsigned int i = 0; i < pushConstCount; i++) { pushConst[i] = bFile::ReadSizeOf<PushConstant>(file); }

    uint32_t pushConstantRequiredBufferSize = bFile::ReadInt(file);


    Shader_VK outShader = Create(logicalDevice, slangPath.data(), entryPointCount, uniformCount, pushConstCount, shaderBuffer);
    
    for (size_t entryPointIdx = 0; entryPointIdx < entryPointCount; entryPointIdx++) { outShader.entryPoints[entryPointIdx]   = entryPoints[entryPointIdx]; }
    for (size_t uniformstIdx  = 0; uniformstIdx  < uniformCount;    uniformstIdx++)  { outShader.uniformOffsets[uniformstIdx] = uniforms[uniformstIdx];     }
    for (size_t pushConstIdx  = 0; pushConstIdx  < pushConstCount;  pushConstIdx++)  { outShader.pushConstants[pushConstIdx]  = pushConst[pushConstIdx];    }

    outShader.uniformRequiredBufferSize       = uniformRequiredBufferSize;
    outShader.pushConstantsRequiredBufferSize = pushConstantRequiredBufferSize;


    free(entryPoints);
    free(uniforms);
    free(pushConst);
    free(date);

    file.close();

    return outShader;
}

//===================================//
//              SLANG                //
//===================================//

void fSlang::Initialize()
{    
    createGlobalSession(SLANG_GLOBAL_SESSION.writeRef());
}

//========================================================================================================================================================================================//

bool fSlang::CompileAndWriteShaderToFile(const vk::raii::Device &logicalDevice, const char *slangPath, const char *spirvPath, Shader_VK &outShader)
{    
    //====================================================================================================================================================================================//
    // COMPILATION
    //====================================================================================================================================================================================//
    std::vector<SlangStage> uniformsShaderStages{};
    std::string buffer = Internal::GetSlangBuffer(slangPath, uniformsShaderStages);
               
    // Create Session
    //
    slang::TargetDesc targetDesc = 
    {
        .format  = SLANG_SPIRV,
        .profile = SLANG_GLOBAL_SESSION->findProfile("spirv_1_4")
    };

    slang::SessionDesc sessionDesc = 
    {
        .targets     = &targetDesc,
        .targetCount = 1,
        .defaultMatrixLayoutMode = SlangMatrixLayoutMode::SLANG_MATRIX_LAYOUT_COLUMN_MAJOR
    };
    
    
    std::array<slang::CompilerOptionEntry, 2> options =
    {
        slang::CompilerOptionEntry
        {                 
            slang::CompilerOptionName::EmitSpirvDirectly,
            { slang::CompilerOptionValueKind::String, 1, 0, nullptr, nullptr },
        },
        slang::CompilerOptionEntry
        {
            slang::CompilerOptionName::VulkanUseEntryPointName,
            { slang::CompilerOptionValueKind::String, 1, 0, nullptr, nullptr },
        },
    };

    sessionDesc.compilerOptionEntries    = options.data();
    sessionDesc.compilerOptionEntryCount = options.size();

    Slang::ComPtr<slang::ISession> session;
    SLANG_GLOBAL_SESSION->createSession(sessionDesc, session.writeRef());


    // Load module
    //
    const char *moduleName = tFile::GetNameWithoutExtension(slangPath);
    std::string modulePath = tFile::GetName(slangPath);    
    
    Slang::ComPtr<slang::IModule> slangModule;
    {
        Slang::ComPtr<slang::IBlob> diagnosticsBlob;
        slangModule = session->loadModuleFromSourceString
        (
            moduleName,
            modulePath.data(),         
            buffer.data(),             // Shader source code
            diagnosticsBlob.writeRef() // Optional diagnostic container
        );

        if (!slangModule)
        {            
            printf("Compilation Failed - [ %s ] - \n", slangPath);
            Internal::Diagnose(diagnosticsBlob);            
            return false;
        }        
    }
    

    // Query Entry Points
    //
    std::vector<const char *> entryPointsNames;
    std::vector<Slang::ComPtr<slang::IEntryPoint>> entryPoints;
    for (size_t poStageIdx = 0; poStageIdx < POSSIBLE_SHADER_STAGES_COUNT; poStageIdx++)    
    {
        Slang::ComPtr<slang::IEntryPoint> entryPoint;
        Slang::ComPtr<slang::IBlob> diagnosticsBlob;            
        slangModule->findEntryPointByName(POSSIBLE_SHADER_STAGES[poStageIdx], entryPoint.writeRef());

        if (entryPoint) 
        {
            entryPointsNames.emplace_back(POSSIBLE_SHADER_STAGES[poStageIdx]);
            entryPoints.emplace_back(entryPoint); 
        }
    }   

    // 5. Compose Modules + Entry Points
    //     
    // @note I reserve 8 even though there may be just 2
    //
    std::array<slang::IComponentType *, 8> components;
    components[0] = slangModule;
    for (size_t i = 0; i < entryPoints.size(); i++) { components[i + 1] = entryPoints[i]; }
   

    Slang::ComPtr<slang::IComponentType> composedProgram;
    {
        Slang::ComPtr<slang::IBlob> diagnosticsBlob;
        SlangResult result = session->createCompositeComponentType
        (
            components.data(),
            entryPoints.size() + 1,
            composedProgram.writeRef(),
            diagnosticsBlob.writeRef()
        );


        if (SLANG_FAILED(result)) 
        {
            Internal::Diagnose(diagnosticsBlob);
            return false;
        }        
    }

    
    // 6. Link
    //
    Slang::ComPtr<slang::IComponentType> linkedProgram;
    {
        Slang::ComPtr<slang::IBlob> diagnosticsBlob;
        SlangResult result = composedProgram->link(linkedProgram.writeRef(), diagnosticsBlob.writeRef());
        
        if (SLANG_FAILED(result)) 
        {
            Internal::Diagnose(diagnosticsBlob);  
            return false; 
        }        
    }

    // 7. Get Target Kernel Code    
    //
    Slang::ComPtr<slang::IBlob> spirvCode;
    {
        Slang::ComPtr<slang::IBlob> diagnosticsBlob;
        SlangResult result = linkedProgram->getTargetCode(0, spirvCode.writeRef(), diagnosticsBlob.writeRef());
        if (SLANG_FAILED(result)) 
        {
            Internal::Diagnose(diagnosticsBlob);
            return false;
        }        
    }       

    
    //====================================================================================================================================================================================//
    // Write .spv
    //====================================================================================================================================================================================//
    //
    Internal::WriteCompiledSpirVToFile(spirvPath, (char *)spirvCode->getBufferPointer(), spirvCode->getBufferSize());
    
    //====================================================================================================================================================================================//
    // Create Shader
    //====================================================================================================================================================================================//
    //
    outShader = Internal::CreateShaderDataAndMetadata(logicalDevice, slangPath, spirvPath, linkedProgram->getLayout(), entryPointsNames, uniformsShaderStages);


    return true;
}

//========================================================================================================================================================================================//

// @note The out OpaqueStages gets every variable present on the shader. Uniforms, push constants etc...
//
std::string fSlang::Internal::GetSlangBuffer(const char *path, std::vector<SlangStage> &outOpaquesStages)
{
    std::ifstream file(path);
    std::string line        = "";
    std::string buffer      = "";

    uint32_t leftOpaqueIdx  = 0;
    uint32_t rightOpaqueIdx = 0;    

    while (std::getline(file, line))
    {
        std::vector<std::string> tokens = fUtil::TokenizeLine(line, ' ', '<', '(');

        if (tokens.size() > 0)
        {            
            if (!tokens[0].compare("ConstantBuffer"))
            {
                outOpaquesStages.emplace_back(SLANG_STAGE_NONE);
                rightOpaqueIdx++;
            }
        }

        // This assigns all the stages to their parameter and you can't shuffle parameters around. They are all read in sequence
        // so ALL the vertex parameters are done in one go, all the fragment parameters are done in one go etc...
        //
        if (tokens.size() > 1)
        {
            if (!tokens[1].compare(VERTEX_SHADER_ENTRY_POINT_NAME))
            {
                for (size_t i = leftOpaqueIdx; i < rightOpaqueIdx; i++) { outOpaquesStages[i] = SlangStage::SLANG_STAGE_VERTEX; }
                leftOpaqueIdx = rightOpaqueIdx;                
            }

            if (!tokens[1].compare(COMPUTE_SHADER_ENTRY_POINT_NAME))
            {
                for (size_t i = leftOpaqueIdx; i < rightOpaqueIdx; i++) { outOpaquesStages[i] = SlangStage::SLANG_STAGE_COMPUTE; }
                leftOpaqueIdx = rightOpaqueIdx;
            }

            if (!tokens[1].compare(FRAGMENT_SHADER_ENTRY_POINT_NAME))
            {
                for (size_t i = leftOpaqueIdx; i < rightOpaqueIdx; i++) { outOpaquesStages[i] = SlangStage::SLANG_STAGE_FRAGMENT; }
                leftOpaqueIdx = rightOpaqueIdx;
            }
        }

        buffer += line + "\n";
    }

    file.close();

    return buffer;
}

Shader_VK fSlang::Internal::CreateShaderDataAndMetadata(const vk::raii::Device &logicalDevice, const char *slangPath, const char *spirvPath, slang::ProgramLayout *programLayout, std::vector<const char*> &entryPoints, std::vector<SlangStage> &parameterStages)
{    
    uint32_t parameterCount     = programLayout->getParameterCount(); // All the uniforms used in the shader
    uint32_t uniformsCount      = 0;    



    auto asd = programLayout->getParameterByIndex(2);

    auto globals = programLayout->getGlobalParamsTypeLayout();    
    uint32_t descriptorSetIndex = asd->getOffset(slang::ParameterCategory::PushConstantBuffer);


    bool vertexStageFound   = false;
    bool fragmentStageFound = false;
    bool computeStageFound  = false;

    std::vector<SlangStage> uniquePushConstantEntriesOrder{};

    // Segragate all the regular uniforms from the push constants, and check how many unique entry points there are
    //
    for (size_t i = 0; i < parameterCount; i++)
    {        
        slang::VariableLayoutReflection *parameter = programLayout->getParameterByIndex(i);
        SlangParameterCategory           category  = SlangParameterCategory(parameter->getCategory());


        if (category != SlangParameterCategory::SLANG_PARAMETER_CATEGORY_PUSH_CONSTANT_BUFFER) 
        {
            uniformsCount++; 
        }


        if (category == SlangParameterCategory::SLANG_PARAMETER_CATEGORY_PUSH_CONSTANT_BUFFER) 
        {
            if (parameterStages[i] == SlangStage::SLANG_STAGE_VERTEX && !vertexStageFound) 
            {
                uniquePushConstantEntriesOrder.emplace_back(SlangStage::SLANG_STAGE_VERTEX);
                vertexStageFound = true;
            }

            if (parameterStages[i] == SlangStage::SLANG_STAGE_COMPUTE && !computeStageFound)
            {
                uniquePushConstantEntriesOrder.emplace_back(SlangStage::SLANG_STAGE_COMPUTE);
                computeStageFound = true;
            }            

            if (parameterStages[i] == SlangStage::SLANG_STAGE_FRAGMENT && !fragmentStageFound)
            {
                uniquePushConstantEntriesOrder.emplace_back(SlangStage::SLANG_STAGE_FRAGMENT);
                fragmentStageFound = true;
            }
        }
    }


    std::vector<char> shaderBuffer = bFile::LoadSpirVShader(spirvPath);
    Shader_VK shader               = fShader_vk::Internal::Create(logicalDevice, slangPath, entryPoints.size(), uniformsCount, uniquePushConstantEntriesOrder.size(), shaderBuffer);   

    for (size_t i = 0; i < entryPoints.size(); i++)                    { shader.entryPoints[i]                    = GetVulkanShaderStageEquivalent(entryPoints[i]);                    }
    for (size_t i = 0; i < uniquePushConstantEntriesOrder.size(); i++) { shader.pushConstants[i].range.stageFlags = GetVulkanShaderStageEquivalent(uniquePushConstantEntriesOrder[i]); }

    uint32_t uniformIdx   = 0;
    uint32_t pushConstIdx = 0;


    for (size_t i = 0; i < parameterCount; i++)
    {
        uint32_t uniformTypeSize                   = 0;
        uint32_t pushConstantSize                  = 0;
        slang::VariableLayoutReflection *parameter = programLayout->getParameterByIndex(i);        
        slang::TypeReflection *type                = programLayout->findTypeByName(parameter->getType()->getElementType()->getName()); // Ex. model_view_projection_ubo        
        SlangParameterCategory parameterCategory   = SlangParameterCategory(parameter->getCategory());
        
        // Regular descriptor slots
        //
        if (type != nullptr && parameterCategory != SlangParameterCategory::SLANG_PARAMETER_CATEGORY_PUSH_CONSTANT_BUFFER)
        {            
            uniformTypeSize += AnalyzeTypeAndGetSize(type);        
            if (uniformIdx + 1 < shader.uniformCount) { shader.uniformOffsets[uniformIdx + 1].offset = uniformTypeSize; } // The first one is always 0 that's why I do this
            shader.uniformOffsets[uniformIdx].shaderStage = Internal::GetVulkanShaderStageEquivalent(parameterStages[i]);
            shader.uniformRequiredBufferSize             += uniformTypeSize;

            uniformIdx++;
        }
        
        // Push Constants
        //
        if (parameterCategory == SlangParameterCategory::SLANG_PARAMETER_CATEGORY_PUSH_CONSTANT_BUFFER)
        {            
            pushConstantSize = AnalyzeTypeAndGetSize(type);

            for (size_t pushIdx = 0; pushIdx < shader.pushConstantsCount; pushIdx++)
            {
                if (parameterStages[i] == SlangStage::SLANG_STAGE_VERTEX && shader.pushConstants[pushIdx].range.stageFlags == vk::ShaderStageFlagBits::eVertex)
                {
                    shader.pushConstants[pushIdx].range.size += pushConstantSize;
                    shader.pushConstants[pushIdx].rangeTypesCount++;
                }

                if (parameterStages[i] == SlangStage::SLANG_STAGE_COMPUTE && shader.pushConstants[pushIdx].range.stageFlags == vk::ShaderStageFlagBits::eCompute)
                {
                    shader.pushConstants[pushIdx].range.size += pushConstantSize;
                    shader.pushConstants[pushIdx].rangeTypesCount++;
                }

                if (parameterStages[i] == SlangStage::SLANG_STAGE_FRAGMENT && shader.pushConstants[pushIdx].range.stageFlags == vk::ShaderStageFlagBits::eFragment)
                {
                    shader.pushConstants[pushIdx].range.size += pushConstantSize;
                    shader.pushConstants[pushIdx].rangeTypesCount++;
                }
            }
        }    
    }
            

    
    // @note Get the offsets
    //
    for (size_t i = 0; i < shader.pushConstantsCount; i++)
    {
        shader.pushConstantsRequiredBufferSize += shader.pushConstants[i].range.size;

        if (i == 0) 
        {
            shader.pushConstants[i].range.offset = 0;
            continue;
        }

        shader.pushConstants[i].range.offset = shader.pushConstants[i - 1].range.offset + shader.pushConstants[i - 1].range.size;
    }







    return shader;
}

void fSlang::Internal::WriteCompiledSpirVToFile(const char *spirvPath, char *spirvCodeBufferPointer, uint32_t spirvBufferSize)
{
    std::ofstream outFile(spirvPath, std::ios::binary);    
    for (size_t i = 0; i < spirvBufferSize; i++)
    {
        outFile << *spirvCodeBufferPointer++;
    }
}


//========================================================================================================================================================================================//

uint32_t fSlang::Internal::SizeOf(std::string &type)
{
    if (!type.compare("int"))     { return sizeof(int);        }
    if (!type.compare("float"))   { return sizeof(float);      }

    if (!type.compare("vector2")) { return sizeof(float) * 2;  }
    if (!type.compare("vector3")) { return sizeof(float) * 3;  }
    if (!type.compare("vector4")) { return sizeof(float) * 4;  }

    if (!type.compare("matrix3")) { return sizeof(float) * 9;  }
    if (!type.compare("matrix4")) { return sizeof(float) * 16; }

    return 0;
}

uint32_t fSlang::Internal::AnalyzeTypeAndGetSize(slang::TypeReflection *type)
{  
    const char *name                 = type->getName();
    slang::TypeReflection::Kind kind = type->getKind();
    uint32_t offsetSize              = 0;        

    switch (kind)
    {
        case slang::TypeReflection::Kind::Struct:
        {
            for (size_t i = 0; i < type->getFieldCount(); i++)
            {
                slang::VariableReflection *member = type->getFieldByIndex(i);
                slang::TypeReflection::Kind kind  = type->getFieldByIndex(i)->getType()->getKind();
                std::string parameter             = "";
                
                if      (kind == slang::TypeReflection::Kind::Scalar) { parameter = member->getType()->getName();                                    }
                else if (kind == slang::TypeReflection::Kind::Vector) { parameter = "vector" + std::to_string(member->getType()->getElementCount()); }
                else if (kind == slang::TypeReflection::Kind::Matrix) { parameter = "matrix" + std::to_string(member->getType()->getColumnCount());  }
                
                offsetSize += SizeOf(parameter);
            }

        }break;

        case slang::TypeReflection::Kind::Scalar:
        {            
            if      (strcmp(name, "int"))   { offsetSize += sizeof(int);   }
            else if (strcmp(name, "float")) { offsetSize += sizeof(float); };            
        }
    }

    return offsetSize;    
}

vk::ShaderStageFlagBits fSlang::Internal::GetVulkanShaderStageEquivalent(SlangStage slangStage)
{
    switch (slangStage)
    {
        case SLANG_STAGE_VERTEX:   { return vk::ShaderStageFlagBits::eVertex;   }break;
        case SLANG_STAGE_FRAGMENT: { return vk::ShaderStageFlagBits::eFragment; }break;
        case SLANG_STAGE_COMPUTE:  { return vk::ShaderStageFlagBits::eCompute;  }break;
    }

    std::cout << "[ERROR] - Function Name - GetVulkanShaderStageEquivalent - Couldn't find a vulkan shader stage equivalent\n";
    return (vk::ShaderStageFlagBits)(-1);
}

vk::ShaderStageFlagBits fSlang::Internal::GetVulkanShaderStageEquivalent(const char *shaderStageName)
{
    
    if      (!strcmp(shaderStageName, VERTEX_SHADER_ENTRY_POINT_NAME))   { return vk::ShaderStageFlagBits::eVertex;   }
    else if (!strcmp(shaderStageName, FRAGMENT_SHADER_ENTRY_POINT_NAME)) { return vk::ShaderStageFlagBits::eFragment; }    
}

void fSlang::Internal::Diagnose(slang::IBlob *diagnosticsBlob)
{    
    std::cout << (const char *)diagnosticsBlob->getBufferPointer() << std::endl;
    printf("==================================================================================\n");    
}


//========================================================================================================================================================================================//