#include "Buffer.h"

Buffer fBuffer::Create(vk::raii::PhysicalDevice &physicalDevice, vk::raii::Device &logicalDevice, uint32_t bufferSizeInBytes, vk::BufferUsageFlags usage, vk::MemoryPropertyFlags memoryProperties)
{
    Buffer buffer = Buffer();
    
    vk::BufferCreateInfo createInfo
    {
        .size        = bufferSizeInBytes, 
        .usage       = usage,
        .sharingMode = vk::SharingMode::eExclusive
    };

    buffer.buffer = vk::raii::Buffer(logicalDevice, createInfo);

    vk::MemoryRequirements memRequirements = buffer.buffer.getMemoryRequirements();

    vk::MemoryAllocateInfo memoryAllocateInfo
    {
        .allocationSize = memRequirements.size,
        .memoryTypeIndex = fMemory::FindMemoryType(physicalDevice, memRequirements.memoryTypeBits, memoryProperties),
    };

    // buffer.memory = vk::raii::DeviceMemory(logicalDevice, memoryAllocateInfo);
    // buffer.buffer.bindMemory(buffer.memory, 0);
    
    vk::raii::DeviceMemory memory = vk::raii::DeviceMemory(logicalDevice, memoryAllocateInfo);
    buffer.buffer.bindMemory(memory, 0);

    buffer.memoryMap = malloc(sizeof(bufferSizeInBytes));
    
    return buffer;
}


Buffer fBuffer::CreateAndMapMemory(vk::raii::PhysicalDevice &physicalDevice, vk::raii::Device &logicalDevice, void *bufferData, uint32_t bufferSizeInBytes, vk::BufferUsageFlags usage, vk::MemoryPropertyFlags memoryProperties)
{
    Buffer buffer = Buffer();

    vk::BufferCreateInfo createInfo
    {
        .size        = bufferSizeInBytes, 
        .usage       = usage,
        .sharingMode = vk::SharingMode::eExclusive
    };   


    buffer.buffer = vk::raii::Buffer(logicalDevice, createInfo);

    vk::MemoryRequirements memRequirements = buffer.buffer.getMemoryRequirements();

    vk::MemoryAllocateInfo memoryAllocateInfo
    {
        .allocationSize  = memRequirements.size,
        .memoryTypeIndex = fMemory::FindMemoryType(physicalDevice, memRequirements.memoryTypeBits, memoryProperties),
    };

    buffer.memory = vk::raii::DeviceMemory(logicalDevice, memoryAllocateInfo);    
    buffer.buffer.bindMemory(buffer.memory, 0);

    void *finalData = buffer.memory.mapMemory(0, createInfo.size);
    memcpy(finalData, bufferData, createInfo.size);
    //buffer.memory.unmapMemory();


    return buffer;
}


//====================================================================================================================================================================================
// MULTIPLE QUEUES BELOW
//====================================================================================================================================================================================
//
Buffer fBuffer::Create(const vk::raii::PhysicalDevice &physicalDevice, const vk::raii::Device &logicalDevice, const std::vector<uint32_t> queueFamilyIndices, const uint32_t bufferSizeInBytes, const vk::BufferUsageFlags usage, const vk::MemoryPropertyFlags memoryProperties)
{
    Buffer buffer = Buffer();

    vk::BufferCreateInfo createInfo
    {
        .size                  = bufferSizeInBytes,
        .usage                 = usage,
        .sharingMode           = vk::SharingMode::eConcurrent,
        .queueFamilyIndexCount = (uint32_t)queueFamilyIndices.size(),
        .pQueueFamilyIndices   = queueFamilyIndices.data()
    };

    buffer.buffer = vk::raii::Buffer(logicalDevice, createInfo);

    vk::MemoryRequirements memRequirements = buffer.buffer.getMemoryRequirements();

    vk::MemoryAllocateInfo memoryAllocateInfo
    {
        .allocationSize  = memRequirements.size,
        .memoryTypeIndex = fMemory::FindMemoryType(physicalDevice, memRequirements.memoryTypeBits, memoryProperties),
    };

    buffer.memory = vk::raii::DeviceMemory(logicalDevice, memoryAllocateInfo);    
    buffer.buffer.bindMemory(buffer.memory, 0);
    buffer.memoryMap = buffer.memory.mapMemory(0, bufferSizeInBytes);

    // memmove(buffer.memoryMap, 0, bufferSizeInBytes);
    // memory.unmapMemory();


    return buffer;
}


Buffer fBuffer::CreateAndMapMemory(const vk::raii::PhysicalDevice &physicalDevice, const vk::raii::Device &logicalDevice, std::vector<uint32_t> queueFamilyIndices, const void *bufferData, const uint32_t bufferSizeInBytes, const vk::BufferUsageFlags usage, const vk::MemoryPropertyFlags memoryProperties)
{
    Buffer buffer = Buffer();

    vk::BufferCreateInfo createInfo
    {
        .size                  = bufferSizeInBytes,
        .usage                 = usage,
        .sharingMode           = vk::SharingMode::eConcurrent,
        .queueFamilyIndexCount = (uint32_t)queueFamilyIndices.size(),
        .pQueueFamilyIndices   = queueFamilyIndices.data()
    };


    buffer.buffer = vk::raii::Buffer(logicalDevice, createInfo);

    vk::MemoryRequirements memRequirements = buffer.buffer.getMemoryRequirements();

    vk::MemoryAllocateInfo memoryAllocateInfo
    {
        .allocationSize  = memRequirements.size,
        .memoryTypeIndex = fMemory::FindMemoryType(physicalDevice, memRequirements.memoryTypeBits, memoryProperties),
    };

    buffer.memory = vk::raii::DeviceMemory(logicalDevice, memoryAllocateInfo);    
    buffer.buffer.bindMemory(buffer.memory, 0);

    void *finalData = buffer.memory.mapMemory(0, createInfo.size);
    memcpy(finalData, bufferData, createInfo.size);
    buffer.memory.unmapMemory();


    return buffer;
}


void fBuffer::Copy(const vk::raii::Device &logicalDevice, const vk::raii::CommandPool &commandPool, const vk::raii::Queue &transferQueue, const Buffer &srcBuffer, Buffer &dstBuffer, const uint32_t sizeInBytes)
{
    vk::CommandBufferAllocateInfo allocateInfo
    {
        .commandPool        = commandPool,
        .level              = vk::CommandBufferLevel::ePrimary,
        .commandBufferCount = 1,
    };

    vk::raii::CommandBuffer commandCopyBuffer = std::move(logicalDevice.allocateCommandBuffers(allocateInfo).front());

    commandCopyBuffer.begin(vk::CommandBufferBeginInfo{ .flags = vk::CommandBufferUsageFlagBits::eOneTimeSubmit });

        commandCopyBuffer.copyBuffer(srcBuffer.buffer, dstBuffer.buffer, vk::BufferCopy(0, 0, sizeInBytes));

    commandCopyBuffer.end();

    transferQueue.submit(vk::SubmitInfo{ .commandBufferCount = 1, .pCommandBuffers = &*commandCopyBuffer }, nullptr);
    transferQueue.waitIdle();
}


void fBuffer::Delete(Buffer &buffer)
{
    buffer.buffer.clear();
    buffer.memory.clear();
    free(buffer.memoryMap);
}





//====================================================================================================================================================================================
// Custom functions using the above routines for creating buffers used for different purposes
//====================================================================================================================================================================================
//
Buffer fBuffer::CreateVertexBuffer(const vk::raii::PhysicalDevice &physicalDevice, const vk::raii::Device &logicalDevice, const vk::raii::CommandPool &commandPool, const vk::raii::Queue &transferQueue, std::vector<uint32_t> queueFamilyIndices, const void *vertices, const uint32_t dSize)
{
    uint32_t                sizeOf      = dSize;
    vk::MemoryPropertyFlags memoryFlags = vk::MemoryPropertyFlagBits::eHostCoherent | vk::MemoryPropertyFlagBits::eHostVisible;


    Buffer stagingBuffer = CreateAndMapMemory(physicalDevice, logicalDevice, queueFamilyIndices, vertices, sizeOf, vk::BufferUsageFlagBits::eVertexBuffer | vk::BufferUsageFlagBits::eTransferSrc, memoryFlags);
    Buffer vertexBuffer  = Create(physicalDevice, logicalDevice, queueFamilyIndices, sizeOf, vk::BufferUsageFlagBits::eVertexBuffer | vk::BufferUsageFlagBits::eTransferDst, memoryFlags);
    Copy(logicalDevice, commandPool, transferQueue, stagingBuffer, vertexBuffer, sizeOf);

    return vertexBuffer;
}

Buffer fBuffer::CreateIndexBuffer(const vk::raii::PhysicalDevice &physicalDevice, const vk::raii::Device &logicalDevice, const vk::raii::CommandPool &commandPool, const vk::raii::Queue &transferQueue, std::vector<uint32_t> queueFamilyIndices, const int *indices, const uint32_t iCount)
{
    uint32_t                sizeOf      = sizeof(int) * iCount;
    vk::MemoryPropertyFlags memoryFlags = vk::MemoryPropertyFlagBits::eHostCoherent | vk::MemoryPropertyFlagBits::eHostVisible;


    Buffer stagingBuffer = CreateAndMapMemory(physicalDevice, logicalDevice, queueFamilyIndices, indices, sizeOf, vk::BufferUsageFlagBits::eTransferSrc | vk::BufferUsageFlagBits::eIndexBuffer, memoryFlags);
    Buffer indexBuffer   = Create(physicalDevice, logicalDevice, queueFamilyIndices, sizeOf, vk::BufferUsageFlagBits::eTransferDst | vk::BufferUsageFlagBits::eIndexBuffer, memoryFlags);
    Copy(logicalDevice, commandPool, transferQueue, stagingBuffer, indexBuffer, sizeOf);

    return indexBuffer;
}

