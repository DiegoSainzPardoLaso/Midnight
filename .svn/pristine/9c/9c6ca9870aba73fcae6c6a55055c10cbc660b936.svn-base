#include "VulkanConfig.h"


#include "../../File/File.h"
#include "../../Utilities/Utilities.hpp"
#include "../../Engine/EngineConfig.h"


struct UniformOffset
{
	uint32_t			    offset;             
	vk::ShaderStageFlagBits shaderStage;			 // @note In which shader stage each parameter is located 
};



struct PushConstant
{
	vk::PushConstantRange  range;
	PRIMITIVE_TYPE		  *typesInsideTheRange;
	uint32_t			   rangeTypesCount;


	bool operator == (vk::ShaderStageFlags stage) { return this->range.stageFlags == stage; }
	bool operator != (vk::ShaderStageFlags stage) { return this->range.stageFlags != stage; }
};


struct Shader_VK
{
	char					 path[128];
	long long				 lastModifiedTime;


	// @note The stages present in this shader. I need this for the pipeline creation
	//
	vk::ShaderStageFlagBits *entryPoints;
	uint32_t				 entryPointsCount;
	

	UniformOffset			*uniformOffsets;				// @note Each struct is an offset. The first one is always 0 and the last one is never stored(But it's size is taken into account for the final byteSize)    									  
    uint32_t				 uniformCount;                 
    uint32_t				 uniformRequiredBufferSize;		// @note the sum of all uniforms	
		

	// @note For what I've seen the vulkan specification states that there can't be 2 pushConstantRanges with the same stage.
	// So I need to have a push constant range for every possible stage... |:-(
	//
	PushConstant			*pushConstants;
	uint32_t				 pushConstantsCount;
	uint32_t				 pushConstantsRequiredBufferSize;


	vk::raii::ShaderModule	 module = nullptr;
};

namespace fShader_vk
{			
	// If the shader fails to compile, a copy of the 'bad_compilation.slang' shader will be returned 	
	Shader_VK Load(const vk::raii::Device &logicalDevice, const char *slangPath, bool forceCompilation);
	void Destroy(Shader_VK shader);
	 

	namespace Internal
	{		
		Shader_VK Create(const vk::raii::Device &logicalDevice, const char *slangPath, const uint32_t entryPointsCount, const uint32_t offsetsCount, const uint32_t rangeTypesCount, std::vector<char> &shaderSpirVBuffer);
		
		vk::raii::ShaderModule CreateShaderModule(const vk::raii::Device &LOGICAL_DEVICE, std::vector<char> &shaderBuffer);
		void				   WritePSMBToFile(const char *fileName, Shader_VK &shader);
		Shader_VK			   LoadPrecompiledShaderAndItsPSMB(const vk::raii::Device &logicalDevice, const char *spirvPath);
	}

}



extern Slang::ComPtr<slang::IGlobalSession> SLANG_GLOBAL_SESSION;
namespace fSlang
{	
	void Initialize();
	bool CompileAndWriteShaderToFile(const vk::raii::Device &logicalDevice, const char *slangPath, const char *spirvPath, Shader_VK &outShader);
	
	namespace Internal
	{		
		std::string				GetSlangBuffer(const char *path, std::vector<SlangStage> &outOpaquesStages);
		Shader_VK				CreateShaderDataAndMetadata(const vk::raii::Device &logicalDevice, const char *slangPath, const char *spirvPath, slang::ProgramLayout *programLayout, std::vector<const char *> &entryPoints, std::vector<SlangStage> &uniformStages);
		void					WriteCompiledSpirVToFile(const char *spirvPath, char *spirvCodeBufferPointer, uint32_t spirvBufferSize);

		uint32_t				SizeOf(std::string &type);
		uint32_t				AnalyzeTypeAndGetSize(slang::TypeReflection *type);
		vk::ShaderStageFlagBits GetVulkanShaderStageEquivalent(SlangStage slangStage);
		vk::ShaderStageFlagBits GetVulkanShaderStageEquivalent(const char *shaderStageName);
		void					Diagnose(slang::IBlob *diagnosticsBlob);
	}	
