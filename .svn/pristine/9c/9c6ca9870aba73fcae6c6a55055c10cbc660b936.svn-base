#pragma once

#include <fstream>

#define VK_USE_PLATFORM_WIN32_KHR
#define VULKAN_HPP_NO_CONSTRUCTORS
#include <vulkan/vulkan_raii.hpp>


#include <slang/slang.h>
#include <slang/slang-com-ptr.h>
