#include "Renderer.h"


void fRenderer::Initialize()
{                     

    // @important // @note In OPENGL the frame pacing issues can be fixed by going to the nvidia control panel and turning max fps on active application to the monitor
    // refresh rate, but that solution isn't ideal...

    Internal::OUTLINE_SHADER      = fShader::Create("C:/Midnight/shaders/glsl/outline.shader");
    Internal::CURRENT_RENDER_MODE = RENDERING_MODE::FILL_MODE;
   

    // ============================================================================================================================================        
    std::string shaderSource = DEFAULT_OPENGL_SHADER_PATH + "default.shader";
    std::string meshSource   = DEFAULT_MESH_PATH          + "Debug_Gizmos/Ornament_Gizmos_01.mof";
    std::string animSource   = DEFAULT_MESH_PATH          + "TEST/cubeBend.maf";
    
    std::vector<const char*> uv12 = 
    { 
        "C:/Midnight/resources/textures/Crystal_Base.png",
    }; 
    
    tstEntity         = EntityManager::CreateEntity(meshSource.data(), shaderSource.data(), uv12);
    Animation tstAnim = MAFLoader::LoadAnimation(animSource.data());
    AddAnimation(tstEntity->animator, tstAnim);
    SwitchAnimation(tstEntity->animator, &tstEntity->animator.animations[0]);        
	                
    //fMGUI::Initialize();

    //inputText = fInputText::Create(500, 100);
    
    //fText::Test();       
    
    // ============================================================================================================================================    
}


void fRenderer::Draw(Vec2 &windowDimensions, CameraSystem *&cameraSystem, Console *&console, Grid *&grid, Gizmos *&gizmos, RenderNodeSystem_OGL *&renderablesManager)
{
    glClearColor(backgroundColor.x, backgroundColor.y, backgroundColor.z, backgroundColor.w); // Sets the color [State setting function]
    glClear     (GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);                                  //                [State using function]
    glEnable    (GL_DEPTH_TEST);
    //glEnable(GL_CULL_FACE);

    UpdateDrawMode();


    DrawSelectedObjectsOutline(gizmos, cameraSystem, renderablesManager);
    // DrawEntities(EntityManager::entities, *cameraSystem->activeCamera);
    DrawCameras(cameraSystem, renderablesManager->cameras);


    DrawGrid(grid, cameraSystem->activeCamera);
    DrawGizmos(gizmos, cameraSystem->activeCamera);
    DrawCommandConsole(console, windowDimensions);
    //for (unsigned int i = 0; i < screenSpaceText.size(); i++) { DrawScreenSpaceGUIText(screenSpaceText[i], windowDimensions); }
    //fMGUI::TESTGUI();
    //fMGUI::Draw();   
}


void fRenderer::UpdateDrawMode()
{
    if ((Input::Key_Left_Shift && Input::Key_1) || (Input::Key_Left_Shift && Input::Key_Numpad_1)) { glPolygonMode(GL_FRONT_AND_BACK, GL_FILL);  Internal::CURRENT_RENDER_MODE = RENDERING_MODE::FILL_MODE; }
    if ((Input::Key_Left_Shift && Input::Key_2) || (Input::Key_Left_Shift && Input::Key_Numpad_2)) { glPolygonMode(GL_FRONT_AND_BACK, GL_LINE);  Internal::CURRENT_RENDER_MODE = RENDERING_MODE::LINE_MODE; }
    if ((Input::Key_Left_Shift && Input::Key_3) || (Input::Key_Left_Shift && Input::Key_Numpad_3)) { glPolygonMode(GL_FRONT_AND_BACK, GL_POINT); Internal::CURRENT_RENDER_MODE = RENDERING_MODE::POINT_MODE; }
    if ((Input::Key_Left_Shift && Input::Key_4) || (Input::Key_Left_Shift && Input::Key_Numpad_4)) { toggleDebugShapes = true; }
    if ((Input::Key_Left_Shift && Input::Key_5) || (Input::Key_Left_Shift && Input::Key_Numpad_5)) { toggleDebugShapes = false;                                                                              }
}


void fRenderer::RestoreDrawMode(RENDERING_MODE mode)
{
    switch (mode)
    {
        case FILL_MODE:  { glPolygonMode(GL_FRONT_AND_BACK, GL_FILL);  }break;
        case LINE_MODE:  { glPolygonMode(GL_FRONT_AND_BACK, GL_LINE);  }break;
        case POINT_MODE: { glPolygonMode(GL_FRONT_AND_BACK, GL_POINT); }break;
    }
}


void fRenderer::DrawEntities(std::vector<Entity::Animated*> &entities, Camera &activeCamera)
{        
    for (int eI = 0; eI < entities.size(); eI++)
    {
        // 1. Use program
        //               
        glUseProgram(entities.at(eI)->material.shader.program);

        // 2. Pass data to the shader
        // 2.1 Update Model matrix
        //               
        Mat4 mvp           = entities.at(eI)->transform.model * activeCamera.view * activeCamera.projection;
        unsigned int mvdId = glGetUniformLocation(entities.at(eI)->material.shader.program, "mvp");
        glUniformMatrix4fv(mvdId, 1, GL_FALSE, &mvp.data[0]);
        
        // 2.2 Pass skeleton if it has one
        //
        // @warning // @warning // @warning
        fSkeleton::Update(tstEntity->skeleton);
        unsigned int skel = glGetUniformLocation(entities.at(eI)->material.shader.program, "jointTransforms");
        glUniformMatrix4fv(skel, 128, GL_FALSE, &tstEntity->skeleton.jointFlatData[0]);        

        int size = entities.at(eI)->material.textureCount;
        // 3. Update Texture Bindings
        //
        for (int tI = 0; tI < size; tI++)
        {
            // @note just need a reference to the first texture name inside the shader.
            // If there's multiple textures gl will load the rest loaded textures into the corresponding uniforms
            // so just a reference to albedo, and the rest of texture uniforms should just go below.
            glUniform1i(glGetUniformLocation(entities.at(eI)->material.shader.program, "albedo"), tI);

            glActiveTexture(GL_TEXTURE0 + tI);
            glBindTexture(GL_TEXTURE_2D, entities.at(eI)->material.textures[tI].id);
        }
        

        // 4. Bind the VAO
        //
        glBindVertexArray(entities.at(eI)->mesh.VAO);

        // 5. Draw        
        // @HIM, always pass the index count as it has the total number of vertices to draw even when the mesh has been deduplicated
        // 
        glDrawElements(GL_TRIANGLES, entities.at(eI)->mesh.iCount, GL_UNSIGNED_INT, 0);
    }
    
}


void fRenderer::DrawCameras(CameraSystem *&cameraSystem, std::vector<StaticRendereableObjectOpenGL> &RO_Cameras)
{

    for (int cameraIdx = 0; cameraIdx < RO_Cameras.size(); cameraIdx++)
    {
        if (cameraSystem->cameras[cameraIdx].index != cameraSystem->activeCamera->index)
        {                        
            glUseProgram(RO_Cameras[cameraIdx].material.shader.program);


            Mat4 mvp = cameraSystem->cameras[cameraIdx].transform.model * cameraSystem->activeCamera->view * cameraSystem->activeCamera->projection;
            int mvpIdx = glGetUniformLocation(RO_Cameras[cameraIdx].material.shader.program, "mvp");
            glUniformMatrix4fv(mvpIdx, 1, GL_FALSE, &mvp.data[0]);

            glBindVertexArray(RO_Cameras[cameraIdx].VAO);

            glDrawElements(GL_TRIANGLES, cameraSystem->cameras[cameraIdx].mesh.iCount, GL_UNSIGNED_INT, 0);


            // if (toggleDebugShapes)
            // {
            //     glEnable(GL_BLEND);
            //     glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
            //     glUseProgram(cameraSystem->cameras[cameraIdx].boundingBox.material.shader.program);
            // 
            //     int model = glGetUniformLocation(cameraSystem->cameras[cameraIdx].boundingBox.material.shader.program, "model");
            //     int view  = glGetUniformLocation(cameraSystem->cameras[cameraIdx].boundingBox.material.shader.program, "view");
            //     int proj  = glGetUniformLocation(cameraSystem->cameras[cameraIdx].boundingBox.material.shader.program, "projection");
            //     int alpha = glGetUniformLocation(cameraSystem->cameras[cameraIdx].boundingBox.material.shader.program, "in_alpha");
            // 
            //     glUniformMatrix4fv(model, 1, GL_FALSE, &cameraSystem->cameras[cameraIdx].transform.model.data[0]);
            //     glUniformMatrix4fv(view,  1, GL_FALSE, &cameraSystem->activeCamera->view.data[0]);
            //     glUniformMatrix4fv(proj,  1, GL_FALSE, &cameraSystem->activeCamera->projection.data[0]);
            //             
            //     glUniform1f(alpha, 0.2f);
            // 
            //     glBindVertexArray(cameraSystem->cameras[cameraIdx].boundingBox.mesh.VAO);
            // 
