// @todo This works great, but take a look at the stencil buffer way of doing it
//
void fRenderer::DrawSelectedObjectsOutline(Gizmos *&gizmos, CameraSystem *&cameraSystem, RenderNodeSystem_OGL *&renderableManager)
{
    switch (gizmos->retrievedDataInformation.objectType)
    {
        case ENGINE_TYPE::CAMERA:
        {
            if (cameraSystem->activeCamera->index != gizmos->retrievedDataInformation.objectIndex)
            {            
                glEnable(GL_CULL_FACE);            
                glEnable(GL_LINE_SMOOTH);
            

                glLineWidth(10);
                glPolygonMode(GL_FRONT_AND_BACK, GL_LINE);

                // @note Changing this to back causes the mesh to 'reveal' its geometry
                //
                glCullFace(GL_FRONT);

                glUseProgram(Internal::OUTLINE_SHADER.program);

                int modelIdx = glGetUniformLocation(Internal::OUTLINE_SHADER.program, "model");
                int viewIdx  = glGetUniformLocation(Internal::OUTLINE_SHADER.program, "view");
                int projIdx  = glGetUniformLocation(Internal::OUTLINE_SHADER.program, "projection");
                int oColIdx  = glGetUniformLocation(Internal::OUTLINE_SHADER.program, "outline_color");

                glUniformMatrix4fv(modelIdx, 1, GL_FALSE, &cameraSystem->cameras[gizmos->retrievedDataInformation.objectIndex].transform.model.data[0]);
                glUniformMatrix4fv(viewIdx,  1, GL_FALSE, &cameraSystem->activeCamera->view.data[0]);
                glUniformMatrix4fv(projIdx,  1, GL_FALSE, &cameraSystem->activeCamera->projection.data[0]);
                glUniform4f       (oColIdx,  selectionObjectOutlineColor.x, selectionObjectOutlineColor.y, selectionObjectOutlineColor.z, selectionObjectOutlineColor.w);

                glBindVertexArray(renderableManager->cameras[gizmos->retrievedDataInformation.objectIndex].VAO);
                glDrawElements(GL_TRIANGLES, cameraSystem->cameras[gizmos->retrievedDataInformation.objectIndex].mesh.iCount, GL_UNSIGNED_INT, 0);


                glPolygonMode(GL_FRONT_AND_BACK, GL_FILL);
                glLineWidth(1);
                glDisable(GL_LINE_SMOOTH);
                glDisable(GL_CULL_FACE);
                RestoreDrawMode(Internal::CURRENT_RENDER_MODE);
            }
        }break;
    }
}



void fRenderer::RenderGenericGUI(unsigned int& shaderProgram, unsigned int& VAO, float x, float y, float width, float height, int iCount, Vec2& wDim)
{
    glDisable(GL_DEPTH_TEST);
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);


    glUseProgram(shaderProgram);

    unsigned int resolution = glGetUniformLocation(shaderProgram, "resolution");
    unsigned int transform  = glGetUniformLocation(shaderProgram,  "transform");

    glUniform2f(transform,  x, y);
    glUniform2f(resolution, wDim.width, wDim.height);

    glBindVertexArray(VAO);
    glDrawElements(GL_TRIANGLES, iCount, GL_UNSIGNED_INT, 0);


    glDisable(GL_BLEND);
    glEnable(GL_DEPTH_TEST);
}

                                                
void fRenderer::DrawScreenSpaceGUIText(Text*& text, Vec2 wDimen)
{
    if (text->kind == TextType::STATIC_TEXT)
    {
        glDisable(GL_DEPTH_TEST);
        glEnable(GL_BLEND);
        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);

        glUseProgram(text->font.material.shader.program);
    
        int res       = glGetUniformLocation(text->font.material.shader.program, "res");
        int transform = glGetUniformLocation(text->font.material.shader.program, "transform");

        glUniform2f(res, (float)wDimen.width, (float)wDimen.height);
        glUniform2f(transform, text->transform.x, text->transform.y);

    
    
        glActiveTexture(GL_TEXTURE0);
        glUniform1i(glGetUniformLocation(text->font.material.shader.program, "fontAtlas"), 0);
        glBindTexture(GL_TEXTURE_2D, text->font.material.textures[0].id);
    

        glBindVertexArray(text->mesh.VAO);
        glDrawElements(GL_TRIANGLES, text->mesh.iCount, GL_UNSIGNED_INT, 0);


        glDisable(GL_BLEND);
        glEnable(GL_DEPTH_TEST);
    }
}