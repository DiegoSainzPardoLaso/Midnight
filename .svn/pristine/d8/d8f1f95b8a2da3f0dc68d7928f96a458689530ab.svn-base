void fRenderer::DrawGizmos(Gizmos *&gizmos, Camera *&camera)
{
    glClear(GL_DEPTH_BUFFER_BIT);

    glUseProgram(gizmos->material.shader.program);

    int model      = glGetUniformLocation(gizmos->material.shader.program, "model");
    int view       = glGetUniformLocation(gizmos->material.shader.program, "view");
    int projection = glGetUniformLocation(gizmos->material.shader.program, "projection");
    int bbcomul    = glGetUniformLocation(gizmos->material.shader.program, "in_color_multiplier");

    glUniformMatrix4fv(model,      1, GL_FALSE, &gizmos->transform.model.data[0]);
    glUniformMatrix4fv(view,       1, GL_FALSE, &camera->view.data[0]);
    glUniformMatrix4fv(projection, 1, GL_FALSE, &camera->projection.data[0]);


    if (gizmos->hoveringAxis == X || gizmos->hoveringAxis == XY) 
    {
        glUniform1f(bbcomul, 1.5f); 
    }
    else                           
    {
        glUniform1f(bbcomul, 1.0f); 
    }
    
    
    if (gizmos->currentTransformation == TRANSLATION) 
    {
        glBindVertexArray(gizmos->visualTranslationX.VAO); 
        glDrawElements(GL_TRIANGLES, gizmos->visualTranslationX.iCount, GL_UNSIGNED_INT, 0);

        // glBindVertexArray(gizmos->visualPlaneXY.VAO);
        // glDrawElements(GL_TRIANGLES, gizmos->visualPlaneXY.iCount, GL_UNSIGNED_INT, 0);
    }
    else if (gizmos->currentTransformation == ROTATION)
    {        
        glBindVertexArray(gizmos->visualRotationX.VAO);
        glDrawElements(GL_TRIANGLES, gizmos->visualRotationX.iCount, GL_UNSIGNED_INT, 0);
    }
    else if (gizmos->currentTransformation == SCALING)     
    {
        // glBindVertexArray(gizmos->visualPlaneXY.VAO);
        // glDrawElements(GL_TRIANGLES, gizmos->visualPlaneXY.iCount, GL_UNSIGNED_INT, 0);

        glBindVertexArray(gizmos->visualScalingX.VAO);     
        glDrawElements(GL_TRIANGLES, gizmos->visualScalingX.iCount, GL_UNSIGNED_INT, 0);
    }

    

    if (gizmos->hoveringAxis == Y || gizmos->hoveringAxis == XY) { glUniform1f(bbcomul, 1.5f); }
    else                           { glUniform1f(bbcomul, 1.0f); }

    if (gizmos->currentTransformation == TRANSLATION) 
    {
        glBindVertexArray(gizmos->visualTranslationY.VAO); 
        glDrawElements(GL_TRIANGLES, gizmos->visualTranslationY.iCount, GL_UNSIGNED_INT, 0);        

        // glBindVertexArray(gizmos->visualPlaneXY.VAO);
        // glDrawElements(GL_TRIANGLES, gizmos->visualPlaneXY.iCount, GL_UNSIGNED_INT, 0);
    }
    else if (gizmos->currentTransformation == ROTATION)
    {
        glBindVertexArray(gizmos->visualRotationY.VAO);
        glDrawElements(GL_TRIANGLES, gizmos->visualRotationY.iCount, GL_UNSIGNED_INT, 0);
    }
    else if (gizmos->currentTransformation == SCALING)     
    {
        glBindVertexArray(gizmos->visualScalingY.VAO);     
        glDrawElements(GL_TRIANGLES, gizmos->visualScalingY.iCount, GL_UNSIGNED_INT, 0);
    }

    if (gizmos->hoveringAxis == Z) { glUniform1f(bbcomul, 1.5f); }
    else                           { glUniform1f(bbcomul, 1.0f); }

    if (gizmos->currentTransformation == TRANSLATION) 
    {
        glBindVertexArray(gizmos->visualTranslationZ.VAO); 
        glDrawElements(GL_TRIANGLES, gizmos->visualTranslationZ.iCount, GL_UNSIGNED_INT, 0);
    }
    else if (gizmos->currentTransformation == ROTATION)
    {
        glBindVertexArray(gizmos->visualRotationZ.VAO);
        glDrawElements(GL_TRIANGLES, gizmos->visualRotationZ.iCount, GL_UNSIGNED_INT, 0);
    }
    else if (gizmos->currentTransformation == SCALING)     
    {
        glBindVertexArray(gizmos->visualScalingZ.VAO); 
        glDrawElements(GL_TRIANGLES, gizmos->visualScalingZ.iCount, GL_UNSIGNED_INT, 0);
    }

    glDisable(GL_DEPTH_TEST);
    glUniform1f(bbcomul, 1.5f);
    glBindVertexArray(gizmos->pivotPoint.VAO);
    glDrawElements(GL_TRIANGLES, gizmos->pivotPoint.iCount, GL_UNSIGNED_INT, 0);
    glEnable(GL_DEPTH_TEST);

    if (gizmos->currentTransformationAxis == ENGINE_AXIS::X) { DrawDebugShapes(gizmos->xLine, camera); }
    if (gizmos->currentTransformationAxis == ENGINE_AXIS::Y) { DrawDebugShapes(gizmos->yLine, camera); }
    if (gizmos->currentTransformationAxis == ENGINE_AXIS::Z) { DrawDebugShapes(gizmos->zLine, camera); }
    
    // DrawDebugShapes(gizmos->xLine, camera);
    // DrawDebugShapes(gizmos->yLine, camera);
    // DrawDebugShapes(gizmos->zLine, camera);

    if (toggleDebugShapes)
    {
        // glEnable(GL_BLEND);
        // glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
        // glUseProgram(gizmos->bBoxTSX.material.shader.program);
        // 
        // // DrawDebugShapes(gizmos->plane, camera);
        // 
        // int bmodel  = glGetUniformLocation(gizmos->bBoxTSX.material.shader.program, "model");
        // int bbview  = glGetUniformLocation(gizmos->bBoxTSX.material.shader.program, "view");
        // int bbproj  = glGetUniformLocation(gizmos->bBoxTSX.material.shader.program, "projection");
        // int bbalpha = glGetUniformLocation(gizmos->bBoxTSX.material.shader.program, "in_alpha");        
        // 
        // glUniformMatrix4fv(bmodel, 1, GL_FALSE, &gizmos->transform.model.data[0]);
        // glUniformMatrix4fv(bbview, 1, GL_FALSE, &camera->view.data[0]);
        // glUniformMatrix4fv(bbproj, 1, GL_FALSE, &camera->projection.data[0]);
        // 
        // glUniform1f(bbalpha, 0.2f);        
        // 
        // 
        // glBindVertexArray(gizmos->bBoxTSX.mesh.VAO);
        // glDrawElements(GL_TRIANGLES, gizmos->bBoxTSX.mesh.iCount, GL_UNSIGNED_INT, 0);
        // 
        // glBindVertexArray(gizmos->bBoxTSY.mesh.VAO);
        // glDrawElements(GL_TRIANGLES, gizmos->bBoxTSY.mesh.iCount, GL_UNSIGNED_INT, 0);
        // 
        // glBindVertexArray(gizmos->bBoxTSZ.mesh.VAO);
        // glDrawElements(GL_TRIANGLES, gizmos->bBoxTSZ.mesh.iCount, GL_UNSIGNED_INT, 0);
        // 
        // 
        // glBindVertexArray(gizmos->bBoxRX.mesh.VAO);
        // glDrawElements(GL_TRIANGLES, gizmos->bBoxRX.mesh.iCount, GL_UNSIGNED_INT, 0);
        // 
        // glBindVertexArray(gizmos->bBoxRY.mesh.VAO);
        // glDrawElements(GL_TRIANGLES, gizmos->bBoxRY.mesh.iCount, GL_UNSIGNED_INT, 0);
        // 
        // glBindVertexArray(gizmos->bBoxRZ.mesh.VAO);
        // glDrawElements(GL_TRIANGLES, gizmos->bBoxRZ.mesh.iCount, GL_UNSIGNED_INT, 0);
        // 
        // glDisable(GL_BLEND);
    }
}


void fRenderer::DrawGrid(Grid*& grid, Camera *&activeCamera)
{
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    
    glUseProgram(grid->material.shader.program);


    Mat4 vp = activeCamera->view * activeCamera->projection;
 
    unsigned int glLocation = glGetUniformLocation(grid->material.shader.program, "vp");
    glUniformMatrix4fv(glLocation, 1, GL_FALSE, &vp.data[0]);

    unsigned int cWPL = glGetUniformLocation(grid->material.shader.program, "cWP");
    glUniform3f(cWPL, activeCamera->transform.position.x, activeCamera->transform.position.y, activeCamera->transform.position.z);

    glDrawArrays(GL_TRIANGLES, 0, 6);

    glDisable(GL_BLEND);    
}


void fRenderer::DrawDebugShapes(DebugShape &shape, Camera *&activeCamera)
{    
    // glClear(GL_DEPTH_BUFFER_BIT);
    
    switch (shape.kind)
    {
        case DEBUG_SHAPE_TYPE::DEBUG_LINE:
        {
            glUseProgram(shape.shader.program);

            unsigned int model = glGetUniformLocation(shape.shader.program, "model");
            unsigned int view  = glGetUniformLocation(shape.shader.program, "view");
            unsigned int proj  = glGetUniformLocation(shape.shader.program, "projection");
            unsigned int alpha = glGetUniformLocation(shape.shader.program, "in_alpha");

            Mat4 id = Identity();
            glUniformMatrix4fv(model, 1, GL_FALSE, &id.data[0]);
            glUniformMatrix4fv(view,  1, GL_FALSE, &activeCamera->view.data[0]);
            glUniformMatrix4fv(proj,  1, GL_FALSE, &activeCamera->projection.data[0]);
            glUniform1f(alpha, 1.0f);
         
            glBindVertexArray(shape.mesh.VAO);
            glDrawArrays(GL_LINES, 0, 2);

        }break;

        default:
        {
            glUseProgram(shape.shader.program);

            unsigned int model = glGetUniformLocation(shape.shader.program, "model");
            unsigned int view  = glGetUniformLocation(shape.shader.program, "view");
            unsigned int proj  = glGetUniformLocation(shape.shader.program, "projection");

            glUniformMatrix4fv(model, 1, GL_FALSE, &shape.transform.model.data[0]);
            glUniformMatrix4fv(view,  1, GL_FALSE, &activeCamera->view.data[0]);
            glUniformMatrix4fv(proj,  1, GL_FALSE, &activeCamera->projection.data[0]);

            glBindVertexArray(shape.mesh.VAO);
            glDrawElements(GL_TRIANGLES, shape.mesh.iCount, GL_UNSIGNED_INT, 0);
        } break;            
        
    }   
}


void fRenderer::DrawCommandConsole(Console*& console, Vec2 wDimen)
{
    glDisable(GL_DEPTH_TEST);
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);


    glUseProgram(console->material.shader.program);

    unsigned int resolution = glGetUniformLocation(console->material.shader.program, "resolution");
    unsigned int transform  = glGetUniformLocation(console->material.shader.program, "transform");

    glUniform2f(transform,  console->transform.x, console->transform.y);
    glUniform2f(resolution, (float)wDimen.width, (float)wDimen.height);

    glBindVertexArray(console->mesh.VAO);
    glDrawElements(GL_TRIANGLES, console->mesh.iCount, GL_UNSIGNED_INT, 0);


    glDisable(GL_BLEND);
    glEnable(GL_DEPTH_TEST);
}


