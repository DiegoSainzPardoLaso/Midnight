#===========================================================================#
#              [ Precompiled Shader Metadata Binary ] .psmb                 #
#===========================================================================#
Note: This files contained the shader metadata information which will be useful to not analyze a shader which has already been compiled and reflected.
Note: The files are gonna be stored inside the same folder as the .spv files (Same name different extension)
Note: The slang_last_write_time is used in case the slang file is different than the spirv file

#===========================================================================#
The data layout of this files is:
#===========================================================================#
uint32_t                    { 4Bytes }                         date_length
char                        { 1Byte * date_length }            date
 
long long				   { 8bytes }		  	           slang_last_write_time 
 
uint32_t                    { 4bytes }                         entry_points_count
vK::ShaderStageFlagBits     { 4bytes * entry_points_count }    entry_points
 
uint32_t                    { 4Bytes  }                        offsets_count
UniformOffset               { 8bytes * offsets_count  }        offsets_array
{                                                              
    uint32_t                { 4Bytes  }                        offset_value    
    vK::ShaderStageFlagBits { 4Bytes  }                        offset_stage
}      

uint32_t                    { 4Bytes  }                        uniforms_byte_size

uint32_t                    { 4Bytes  }                        push_constants_count
PushConstant                { 16bytes * push_constants_count } push_constants_array
{                                                             
    vk::PushConstantRange   { 12Bytes }                        push_constant_size
    uint32_t                { 4Bytes  }                        push_constant_elements_count    
}     
uint32_t                    { 4Bytes  }                        push_constants_byte_size
#===========================================================================#
#===========================================================================#
