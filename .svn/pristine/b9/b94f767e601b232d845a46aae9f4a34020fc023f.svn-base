#include "VulkanRenderer.h"

#pragma region VULKAN_STATE

uint32_t							 CURRENT_FRAME_INDEX	= 0;
RENDERING_MODE						 CURRENT_RENDERING_MODE = FILL_MODE;

// ============================================================================ // 

PFN_vkCreateInstance				 VULKAN_DLL		 = NULL;
vk::raii::Context					 VULKAN_CONTEXT  = {};
vk::raii::Instance					 VULKAN_INSTANCE = nullptr;
									 
vk::raii::PhysicalDevice			 PHYSICAL_DEVICE = nullptr;
vk::raii::Device					 LOGICAL_DEVICE  = nullptr;
vk::raii::SurfaceKHR				 WINDOW_SURFACE  = nullptr;
									 
vk::DebugUtilsMessengerEXT			 DEBUG_MESSENGER = nullptr;
									 
// ============================================================================ // 
#ifdef _DEBUG
	bool							 ENABLE_VALIDATION_LAYERS = true;			
#else
	bool							 ENABLE_VALIDATION_LAYERS = false;				
#endif

std::vector<const char *>			 VALIDATION_LAYERS =
									 {	
									 	 "VK_LAYER_KHRONOS_validation",
									 };
									 
std::vector<const char *>			 REQUIRED_PHYSICAL_DEVICE_EXTENSIONS =
									 {
									  	 VK_KHR_SWAPCHAIN_EXTENSION_NAME,
										 
									 };
									 
std::vector<const char *>			 REQUIRED_EXTENSIONS =
									 {
										 VK_KHR_WIN32_SURFACE_EXTENSION_NAME,
										 VK_KHR_SURFACE_EXTENSION_NAME,										 
									 	 
									 	 // @note This one should always be the last one because If validation layers are not enabled the number of extensions required will be EXTENSIONS.size() - 1 
									 	 // leaving the debug messenger out.
									 	 //
										 VK_EXT_DEBUG_UTILS_EXTENSION_NAME									 	 
									 };
									 
									 
// ============================================================================ // 
									 
Vec2								 CURRENT_DIMENSIONS{};
									 
vk::raii::SwapchainKHR				 SWAP_CHAIN = nullptr;
vk::SurfaceFormatKHR				 SWAP_CHAIN_SURFACE_FORMAT{};
vk::Extent2D						 SWAP_CHAIN_EXTENT{};
									 
std::vector<vk::Image>				 SWAP_CHAIN_IMAGES{};
std::vector<vk::raii::ImageView>	 SWAP_CHAIN_IMAGE_VIEWS{};
									 
// ============================================================================ // 

DepthBuffer							 DEPTH_BUFFER{ nullptr, nullptr, nullptr };
std::vector<vk::Format>				 POSSIBLE_SUPPORTED_DEPTH_FORMATS
									 {
									      vk::Format::eD32Sfloat,             // 32 bits Depth Buffer
									      vk::Format::eD32SfloatS8Uint,       // 32 bits Depth Buffer 8 bits stencil buffer
									      vk::Format::eD24UnormS8Uint,        // 24 bits Depth Buffer 8 bits stencil buffer
									 };
vk::ImageTiling						 DEPTH_IMAGE_TILING = vk::ImageTiling::eOptimal;

// ============================================================================ // 

vk::raii::Pipeline					 SHADER_PIPELINE = nullptr;
vk::raii::PipelineLayout			 SHADER_PIPELINE_LAYOUT   = nullptr;

// ============================================================================ // 

vk::raii::CommandPool				 GRAPHICS_COMMANDS_POOL = nullptr;
std::vector<vk::raii::CommandBuffer> GRAPHICS_COMMAND_BUFFERS{};

vk::raii::CommandPool				 TRANSFER_COMMANDS_POOL = nullptr;
std::vector<vk::raii::CommandBuffer> TRANSFER_COMMAND_BUFFERS{};

// ============================================================================ // 

Picker_VK							*PICKER				    = nullptr;
vk::raii::DescriptorPool             PICKER_DESCRIPTOR_POOL = nullptr;

// ============================================================================ // 
// ============================================================================ // 

Shader_VK							 FAILED_TO_COMPILE_SHADER{};

// ============================================================================ // 

#pragma endregion


void fVulkan::Initialize(HWND &handle, Vec2 &windowDimensions, RenderNodeSystem_VK *&renderNodesSystem, CameraSystem *&cameraSystem)
{	
	// ======================================================================= //
	// Load Vulkan DLL, create the Vulkan Instance and Pick the Graphics Card
	// ======================================================================= //
	Internal::WIN32_LOAD_VULKAN();											   // @note This function just checks if the dll is present
	Internal::CREATE_VULKAN_INSTANCE();
	Internal::PICK_PHYSICAL_DEVICE();


	fSlang::Initialize();

	// ======================================================================= //
	// Debug Messenger Window Surface Logical Device
	// ======================================================================= //
	DEBUG_MESSENGER = fDebugMessenger::Create(VULKAN_INSTANCE, ENABLE_VALIDATION_LAYERS);
	WINDOW_SURFACE  = fWindowSurface::CreateWIN32(VULKAN_INSTANCE, handle);
	Logical_Device::CREATE_LOGICAL_DEVICE_AND_GRAPHICS_AND_PRESENTATION_QUEUE();
	
	
	// ======================================================================= //
	// Create Swap Chain And Depth Buffer
	// ======================================================================= //
	fSwapChain::Create(PHYSICAL_DEVICE, LOGICAL_DEVICE, SWAP_CHAIN, SWAP_CHAIN_IMAGE_VIEWS, SWAP_CHAIN_IMAGES, SWAP_CHAIN_SURFACE_FORMAT, SWAP_CHAIN_EXTENT, WINDOW_SURFACE, vk::PresentModeKHR::eFifo, windowDimensions);	
	DEPTH_BUFFER = fDepthBuffer::Create(PHYSICAL_DEVICE, LOGICAL_DEVICE, SWAP_CHAIN_EXTENT, POSSIBLE_SUPPORTED_DEPTH_FORMATS, DEPTH_IMAGE_TILING);


	GRAPHICS_COMMANDS_POOL   = fCommandBuffers::CreateCommandPool(LOGICAL_DEVICE, Logical_Device::Queues::GRAPHICS_AND_PRESENTATION_QUEUE_FAMILY_INDEX);
	TRANSFER_COMMANDS_POOL   = fCommandBuffers::CreateCommandPool(LOGICAL_DEVICE, Logical_Device::Queues::TRANSFER_QUEUE_FAMILY_INDEX);

	GRAPHICS_COMMAND_BUFFERS = fCommandBuffers::Create(LOGICAL_DEVICE, GRAPHICS_COMMANDS_POOL, MAX_FRAMES_IN_FLIGHT);



	// ======================================================================= //	
	// Renderable Objects
	// ======================================================================= //
	uint32_t descriptorPoolSize = cameraSystem->cameraCount * MAX_FRAMES_IN_FLIGHT;
	descriptorPool			    = fDescriptor::CreateDescriptorPool(LOGICAL_DEVICE, descriptorPoolSize);	
	PICKER_DESCRIPTOR_POOL	    = fDescriptor::CreateDescriptorPool(LOGICAL_DEVICE, descriptorPoolSize);	

	
	// @important This asumes that all the shaders will have a UBO in the vertex stage
	// This should be created based on shader feedback
	//
	std::vector<Binding> bindings =
	{
		{ 0, vk::DescriptorType::eUniformBuffer, 1, vk::ShaderStageFlagBits::eVertex },		
	};

	descriptorSetLayout = fDescriptor::CreateDescriptorSetLayout(LOGICAL_DEVICE, bindings);
	

	renderNodesSystem = fRenderNodeSystem::Create
	(
		PHYSICAL_DEVICE, 
		LOGICAL_DEVICE, 
		TRANSFER_COMMANDS_POOL,
		Logical_Device::Queues::TRANSFER_QUEUE,
		{ Logical_Device::Queues::GRAPHICS_AND_PRESENTATION_QUEUE_FAMILY_INDEX, Logical_Device::Queues::TRANSFER_QUEUE_FAMILY_INDEX }, 
		
		descriptorPool,
		descriptorSetLayout,
		
		cameraSystem
	);
	
	
	

	Shader_VK shader	   = fShader_vk::Load(LOGICAL_DEVICE, "C:/Midnight/shaders/slang/test.slang");
	Pipeline_VK pip		   = fPipeline_VK::Create(LOGICAL_DEVICE, FILL_MODE, VERTEX_TYPE::STATIC_VERTEX, shader, descriptorSetLayout, SWAP_CHAIN_SURFACE_FORMAT.format, DEPTH_BUFFER.format);
	SHADER_PIPELINE		   = std::move(pip.pipeline);	
	SHADER_PIPELINE_LAYOUT = std::move(pip.layout);


	// Graphics_Pipeline::CREATE_GRAPHICS_PIPELINE(FILL);
		
	
	//=======================================================================//

	Synchronization_Objects::CREATE();
	
	//=======================================================================//



	CURRENT_DIMENSIONS = windowDimensions;
}



void fVulkan::RecreationFunctionalities(Vec2 &dimensions)
{
	bool recreateSwapChain = CURRENT_DIMENSIONS == dimensions ? false : true;
	CURRENT_DIMENSIONS = dimensions;

	if (recreateSwapChain && (dimensions.width != 0 || dimensions.height != 0))
	{
		fSwapChain::Recreate(PHYSICAL_DEVICE, LOGICAL_DEVICE, SWAP_CHAIN, SWAP_CHAIN_IMAGE_VIEWS, SWAP_CHAIN_IMAGES, SWAP_CHAIN_SURFACE_FORMAT, SWAP_CHAIN_EXTENT, WINDOW_SURFACE, vk::PresentModeKHR::eFifo, dimensions);		
		fDepthBuffer::Recreate(PHYSICAL_DEVICE, LOGICAL_DEVICE, DEPTH_BUFFER, SWAP_CHAIN_EXTENT, vk::ImageTiling::eOptimal);
	}
	
	if (Input::Key_Left_Shift && fInput::FirstPress(KEY_1) && CURRENT_RENDERING_MODE != FILL_MODE)
	{					
		LOGICAL_DEVICE.waitIdle();
		
		SHADER_PIPELINE.clear();
		Graphics_Pipeline::CREATE_GRAPHICS_PIPELINE(FILL_MODE);  
		CURRENT_RENDERING_MODE = FILL_MODE;		
	}
	
	if (Input::Key_Left_Shift && fInput::FirstPress(KEY_2) && CURRENT_RENDERING_MODE != LINE_MODE)
	{					
		LOGICAL_DEVICE.waitIdle();
	
		SHADER_PIPELINE.clear();
		
		Graphics_Pipeline::CREATE_GRAPHICS_PIPELINE(LINE_MODE);  
		CURRENT_RENDERING_MODE = LINE_MODE;		
	}
	

	//else if (Input::Key_3 && CURRENT_RENDERING_MODE != V_POINT) 
	//{	
	//	// @note Not Supported Yet... Can't find a way of making it happend with the raii wrapper
	//	// 
	//	// LOGICAL_DEVICE.waitIdle();
	//	// Graphics_Pipeline::CREATE_GRAPHICS_PIPELINE(V_POINT); 
	//	// CURRENT_RENDERING_MODE = V_POINT;
	//}
}


void fVulkan::Draw(RenderNodeSystem_VK *&renderableObjectsManager, Camera *&activeCamera, Vec2 &windowDimensions)
{
	if (windowDimensions.width == 0 ||  windowDimensions.height == 0) { return; }


	UpdateMVP_UBO(renderableObjectsManager, activeCamera->view, activeCamera->projection, CURRENT_FRAME_INDEX);



	auto fenceResult = LOGICAL_DEVICE.waitForFences(*Synchronization_Objects::DRAW_FENCE[CURRENT_FRAME_INDEX], vk::True, UINT64_MAX);
	if (fenceResult != vk::Result::eSuccess)
	{
		std::cout << "[ERROR] - Function Name: <DRAW> - Failed to wait for fence\n";
		abort();
	}

	LOGICAL_DEVICE.resetFences(*Synchronization_Objects::DRAW_FENCE[CURRENT_FRAME_INDEX]);

	// @note Structured Bindings useful to get multiple values. Is like usinga a std::tuple<> (In this case is a vk::ResultValue<uint32_t> though)
	//	
	
	auto [result, imageIndex] = SWAP_CHAIN.acquireNextImage(UINT64_MAX, *Synchronization_Objects::PRESENT_COMPLETE_SEMAPHORE[CURRENT_FRAME_INDEX], nullptr);
	 

	GRAPHICS_COMMAND_BUFFERS[CURRENT_FRAME_INDEX].reset();

	
	fCommandBuffers::Record
		(
			GRAPHICS_COMMAND_BUFFERS[CURRENT_FRAME_INDEX], 
			
			SWAP_CHAIN_IMAGES[imageIndex],
			SWAP_CHAIN_IMAGE_VIEWS[imageIndex],
			SWAP_CHAIN_EXTENT, 
			
			DEPTH_BUFFER.image.image, 
			DEPTH_BUFFER.image.imageView, 
			
			SHADER_PIPELINE, 
			SHADER_PIPELINE_LAYOUT, 

			renderableObjectsManager,
			activeCamera->index,
			CURRENT_FRAME_INDEX
		);

	Logical_Device::Queues::GRAPHICS_AND_PRESENTATION_QUEUE.waitIdle();


	vk::PipelineStageFlags WaitDestinationStageMask(vk::PipelineStageFlagBits::eColorAttachmentOutput);
	const vk::SubmitInfo submitInfo
	{
		.waitSemaphoreCount   = 1,
		.pWaitSemaphores	  = &*Synchronization_Objects::PRESENT_COMPLETE_SEMAPHORE[CURRENT_FRAME_INDEX],
		.pWaitDstStageMask    = &WaitDestinationStageMask,
		.commandBufferCount   = 1,
		.pCommandBuffers      = &*GRAPHICS_COMMAND_BUFFERS[CURRENT_FRAME_INDEX],
		.signalSemaphoreCount = 1,
		.pSignalSemaphores    = &*Synchronization_Objects::RENDER_FINISHED_SEMAPHORE[CURRENT_FRAME_INDEX]
	};

	Logical_Device::Queues::GRAPHICS_AND_PRESENTATION_QUEUE.submit(submitInfo, *Synchronization_Objects::DRAW_FENCE[CURRENT_FRAME_INDEX]);

	const vk::PresentInfoKHR presentInfoKHR
	{
		.waitSemaphoreCount = 1,
		.pWaitSemaphores    = &*Synchronization_Objects::RENDER_FINISHED_SEMAPHORE[CURRENT_FRAME_INDEX],
		.swapchainCount     = 1,
		.pSwapchains		= &*SWAP_CHAIN,
		.pImageIndices		= &imageIndex
	};

	result = Logical_Device::Queues::GRAPHICS_AND_PRESENTATION_QUEUE.presentKHR(presentInfoKHR);


	switch (result)
	{
		case vk::Result::eSuccess:		     { } break;
		case vk::Result::eSuboptimalKHR:     { } break;
		case vk::Result::eErrorOutOfDateKHR: { } break;

		default: break;
	}

	CURRENT_FRAME_INDEX = (CURRENT_FRAME_INDEX + 1) % MAX_FRAMES_IN_FLIGHT;
	
 

}


void fVulkan::CleanUp(RenderNodeSystem_VK *&renderNodes)
{
	LOGICAL_DEVICE.waitIdle();

	SHADER_PIPELINE.clear();

	Synchronization_Objects::Clear();

	fRenderNodeSystem::Clear(renderNodes);
	
	for (vk::raii::CommandBuffer &command : GRAPHICS_COMMAND_BUFFERS) { command.clear(); }
	GRAPHICS_COMMANDS_POOL.clear();

	fSwapChain::Clear(SWAP_CHAIN, SWAP_CHAIN_IMAGE_VIEWS);

	SWAP_CHAIN_IMAGES.clear();

	WINDOW_SURFACE.clear();

	LOGICAL_DEVICE.clear();

	VULKAN_INSTANCE.clear();
}



// ================================================================================ //
// Internal
// ================================================================================ //

void fVulkan::Internal::WIN32_LOAD_VULKAN()
{
	HMODULE vulkanModule = LoadLibrary(L"vulkan-1.dll");
	if (!vulkanModule) 
	{ 
		std::cout << "[ERROR] - Function Name <WIN32_LOAD_VULKAN> - Failed to load vulkan module(Vulkan - 1.dll is unavailable)\n"; 
		abort();
	}
	
	VULKAN_DLL = (PFN_vkCreateInstance)GetProcAddress(vulkanModule, "vkCreateInstance");
	if (!VULKAN_DLL) 
	{	
		std::cout << "[ERROR] - Function Name <WIN32_LOAD_VULKAN> - Failed to load vk Instance Function Pointer\n";		
		abort();
	}
}

void fVulkan::Internal::CREATE_VULKAN_INSTANCE()
{
	constexpr vk::ApplicationInfo appInfo
	{
		.pApplicationName	= "Midnight engine",
		.applicationVersion = VK_MAKE_VERSION(1, 0, 0),
		.pEngineName		= "Midnight engine",
		.engineVersion		= VK_MAKE_VERSION(1, 0, 0),
		.apiVersion			= vk::ApiVersion14,
	};
		
	vk::InstanceCreateInfo createInfo{ .pApplicationInfo = &appInfo };
	
	if (ENABLE_VALIDATION_LAYERS)
	{
		if (fValidationLayers::CheckIfTheDesiredValidationLayersAreAvailable(VULKAN_CONTEXT, VALIDATION_LAYERS))
		{
			createInfo.enabledLayerCount   = (uint32_t)VALIDATION_LAYERS.size();
			createInfo.ppEnabledLayerNames = VALIDATION_LAYERS.data();
		}
		else
		{
			std::cout << "[ERROR] - Function Name <" << "CREATE_VULKAN_INSTANCE" << "> - Result <" << 1 << "> " << " - [" << "Failed to Find Required Validation Layers" << "] \n";
			abort();	
		}
	}
	
	std::vector<const char *> extensions = fExtensions::CheckNeededExtensionsAvailabilityAndRetrieveThem(VULKAN_CONTEXT, REQUIRED_EXTENSIONS, ENABLE_VALIDATION_LAYERS);
	
	int size = ENABLE_VALIDATION_LAYERS ? (int)REQUIRED_EXTENSIONS.size() : (int)(REQUIRED_EXTENSIONS.size() - 1);

	// @note That i check for just less than, that's because the debug version causes renderdoc to load debug_utils ext twice
	// but there's no big deal, so just check if it's less than the required extensions and that's it
	//
	if (extensions.size() < size)
	{
		std::cout << "[Error] - Function Name: <CREATE_VULKAN_INSTANCE> - Error <1> - [Failed to retrieved all the extensions needed (Or I'm using RenderDoc)]\n";

		std::cout << "Extensions Required: \n";
		for (const char *ext : REQUIRED_EXTENSIONS)
		{
			std::cout << "\t" << ext << "\n";
		}

		std::cout << "Retrieved Extensions: \n";
		for (const char *ext : extensions)
		{
			std::cout << "\t" << ext << "\n";
		}

		abort();
	}

	createInfo.enabledExtensionCount   = (uint32_t)extensions.size();
	createInfo.ppEnabledExtensionNames = extensions.data();
	

	
	VULKAN_INSTANCE = vk::raii::Instance(VULKAN_CONTEXT, createInfo);
}

void fVulkan::Internal::PICK_PHYSICAL_DEVICE()
{
	std::vector<vk::raii::PhysicalDevice> physicalDevices = VULKAN_INSTANCE.enumeratePhysicalDevices();

	if (physicalDevices.size() == 0)
	{
		std::cerr << "[ERROR] - Function Name: PICK_PHYSICAL_DEVICE - [Failed to Find Any Physical Device on this Machine (This computer doesn't have a Graphics Card Or Your Graphics Card Doesn't Support Vulkan)]\n";
		abort();
	}

	// @note I'm just grabbing the first GPU I find. I should Pickup the "best" one
	//
	PHYSICAL_DEVICE = physicalDevices.at(0);
	
	// ================================================================================ // 
	
	if (!(PHYSICAL_DEVICE.getProperties().apiVersion >= vk::ApiVersion13))
	{
		std::cerr << "[ERROR] - Function Name: PICK_PHYSICAL_DEVICE - [Your Graphics Card Doesn't support Vukan 1.3 or higher]\n";
		abort();
	}

	std::vector<vk::QueueFamilyProperties> queueFamilies = PHYSICAL_DEVICE.getQueueFamilyProperties();

	bool supportGraphics = false;
	for (vk::QueueFamilyProperties &queue : queueFamilies)
	{
		if (queue.queueFlags & vk::QueueFlagBits::eGraphics) { supportGraphics = true; }
	}

	if (!supportGraphics)
	{
		std::cerr << "[ERROR] - Function Name: PICK_PHYSICAL_DEVICE - [Your Graphics Card Doesn't queues with support for graphics]\n";
		abort();
	}

	// ================================================================================ // 

	// @note Check for needed extensions
	//
	auto physicalDeviceExtensions = PHYSICAL_DEVICE.enumerateDeviceExtensionProperties();
	uint32_t supportedExtensions = 0;
	
	for (const char *ext : REQUIRED_PHYSICAL_DEVICE_EXTENSIONS)
	{
		for (auto &pdExt : physicalDeviceExtensions)
		{
			if (strcmp(ext, pdExt.extensionName) == 0) 
			{
				supportedExtensions++; 
			}
		}
	}

	if (supportedExtensions != REQUIRED_PHYSICAL_DEVICE_EXTENSIONS.size())
	{
		std::cerr << "[ERROR] - Function Name: PICK_PHYSICAL_DEVICE - [Your Graphics Card Doesn't support all the required extensions]\n";
		abort();
	}
}

// ================================================================================ //
// Logical Device
// ================================================================================ // 

extern uint32_t		   fVulkan::Logical_Device::Queues::GRAPHICS_AND_PRESENTATION_QUEUE_FAMILY_INDEX = 0;
extern vk::raii::Queue fVulkan::Logical_Device::Queues::GRAPHICS_AND_PRESENTATION_QUEUE			     = 0;

extern uint32_t		   fVulkan::Logical_Device::Queues::TRANSFER_QUEUE_FAMILY_INDEX = 0;
extern vk::raii::Queue fVulkan::Logical_Device::Queues::TRANSFER_QUEUE			    = 0;

// ================================================================================ //

void fVulkan::Logical_Device::CREATE_LOGICAL_DEVICE_AND_GRAPHICS_AND_PRESENTATION_QUEUE()
{
	std::vector<vk::QueueFamilyProperties> queueFamilyProperties = PHYSICAL_DEVICE.getQueueFamilyProperties();

	uint32_t				  graphicsQueueFamilyIndex = 0;
	uint32_t				  transferQueueFamilyIndex = 0;
	vk::QueueFamilyProperties graphicsQueueFamily;	
	vk::QueueFamilyProperties transferQueueFamily;	


	for (uint32_t qfpIdx = 0; qfpIdx < queueFamilyProperties.size(); qfpIdx++)
	{
		if (queueFamilyProperties[qfpIdx].queueFlags & vk::QueueFlagBits::eGraphics && PHYSICAL_DEVICE.getSurfaceSupportKHR(qfpIdx, *WINDOW_SURFACE))
		{
			graphicsQueueFamilyIndex = qfpIdx;
			graphicsQueueFamily		 = queueFamilyProperties[qfpIdx];
		}

		if (queueFamilyProperties[qfpIdx].queueFlags & vk::QueueFlagBits::eTransfer && !(queueFamilyProperties[qfpIdx].queueFlags & vk::QueueFlagBits::eGraphics) && PHYSICAL_DEVICE.getSurfaceSupportKHR(qfpIdx, *WINDOW_SURFACE))
		{
			transferQueueFamilyIndex = qfpIdx;
			transferQueueFamily		 = queueFamilyProperties[qfpIdx];
		}
	}

	if (graphicsQueueFamilyIndex == ~0)
	{
		std::cerr << "[ERORR] - Function Name: CREATE_LOGICAL_DEVICE_AND_QUEUES - Could Not find a queue for Graphics\n";
		abort();
	}

	if (transferQueueFamilyIndex == ~0)
	{
		std::cerr << "[ERORR] - Function Name: CREATE_LOGICAL_DEVICE_AND_QUEUES - Could Not find a queue for Transfers\n";
		abort();
	}

	float graphicsQueueFamilyPriority = 1.0f;
	float transferQueueFamilyPriority = 1.0f;

	std::vector<vk::DeviceQueueCreateInfo> queueCreateInfo
	{	
		// GRAPHICS
		{
			.queueFamilyIndex = graphicsQueueFamilyIndex,
			.queueCount       = 1,
			.pQueuePriorities = &graphicsQueueFamilyPriority
		},
		// TRANSFER
		{
			.queueFamilyIndex = transferQueueFamilyIndex,
			.queueCount		  = 1,
			.pQueuePriorities = &transferQueueFamilyPriority
		},
	};

	
	vk::StructureChain<vk::PhysicalDeviceFeatures2, vk::PhysicalDeviceVulkan11Features, vk::PhysicalDeviceVulkan13Features, vk::PhysicalDeviceExtendedDynamicStateFeaturesEXT> featureChain =
	{
		{
			.features = { .fillModeNonSolid = true }
		},		
		// 11
		{ 
			.shaderDrawParameters = true,
		},
		// 13
		{
			.synchronization2 = true,
			.dynamicRendering = true,   // Gets rid of the necesity of framebuffers and render passes
		},		
		// Dynamic State
		{ 			
			.extendedDynamicState = true,					
		},					
	};		

	vk::DeviceCreateInfo deviceCreateInfo
	{
		.pNext					 = &featureChain.get<vk::PhysicalDeviceFeatures2>(),
		.queueCreateInfoCount	 = (uint32_t)queueCreateInfo.size(),
		.pQueueCreateInfos		 = queueCreateInfo.data(),
		.enabledExtensionCount   = static_cast<uint32_t>(REQUIRED_LOGICAL_DEVICE_EXTENSIONS.size()),
		.ppEnabledExtensionNames = REQUIRED_LOGICAL_DEVICE_EXTENSIONS.data()		
	};



	LOGICAL_DEVICE = vk::raii::Device(PHYSICAL_DEVICE, deviceCreateInfo);
	
	// ================================================================================ //
	
	Queues::GRAPHICS_AND_PRESENTATION_QUEUE_FAMILY_INDEX = graphicsQueueFamilyIndex;
	Queues::GRAPHICS_AND_PRESENTATION_QUEUE              = vk::raii::Queue(LOGICAL_DEVICE, graphicsQueueFamilyIndex, 0);	
	
	Queues::TRANSFER_QUEUE_FAMILY_INDEX					 = transferQueueFamilyIndex;
	Queues::TRANSFER_QUEUE								 = vk::raii::Queue(LOGICAL_DEVICE, transferQueueFamilyIndex, 0);
}

// ================================================================================ // 	
// Graphics Pipeline
// ================================================================================ // 	

 
void fVulkan::Graphics_Pipeline::CREATE_GRAPHICS_PIPELINE(RENDERING_MODE renderingMode)
{			
	// @note The leak I thought existed inside the Shader_vk::Load() function was in fact not a leak, but the baggage
	// that the slang compiler api adds to the program. Almost 60 megs of ram...
	// So that's that
	// 		
	Shader_VK shader = fShader_vk::Load(LOGICAL_DEVICE, "C:/Midnight/shaders/slang/test.slang");
	free(shader.uniformOffsets);
	vk::raii::ShaderModule sModule = std::move(shader.module);



	vk::PipelineShaderStageCreateInfo vertexShaderStageInfo
	{
		.stage  = vk::ShaderStageFlagBits::eVertex,
		.module = sModule,
		.pName  = VERTEX_SHADER_ENTRY_POINT_NAME
	};
	
	vk::PipelineShaderStageCreateInfo fragmentShaderStageInfo
	{
		.stage  = vk::ShaderStageFlagBits::eFragment,
		.module = sModule,
		.pName  = FRAGMENT_SHADER_ENTRY_POINT_NAME
	};
	
	vk::PipelineShaderStageCreateInfo shaderStages[] =
	{
		vertexShaderStageInfo,
		fragmentShaderStageInfo
	};
	
	// ================================================================================ // 	
	// This will cause the configuration of these values to be ignored, 
	// and I'll be able to specify the data at drawing time
	std::vector <vk::DynamicState> dynamicStates = 
	{
		vk::DynamicState::eViewport, 
		vk::DynamicState::eScissor 
	};
	
	vk::PipelineDynamicStateCreateInfo dynamicState
	{
		.dynamicStateCount = (uint32_t)(dynamicStates.size()),
		.pDynamicStates    = dynamicStates.data()
	};
	

	// @important 
	// @note Each Vertex Type should Have one
	// @note Making the viewport and scissors dynamic
	//
	vk::PipelineViewportStateCreateInfo viewportState{ .viewportCount = 1, .scissorCount = 1 };

	auto bindingDescription = GetBindingDescription();
	auto attributeDescripti = GetAttributeDescriptions();

	vk::PipelineVertexInputStateCreateInfo vertexInputInfo
	{
		.vertexBindingDescriptionCount   = 1,
		.pVertexBindingDescriptions      = &bindingDescription,
		.vertexAttributeDescriptionCount = static_cast<uint32_t>(attributeDescripti.size()),
		.pVertexAttributeDescriptions	 = attributeDescripti.data()
	};
	




	// ================================================================================ //

	vk::PipelineInputAssemblyStateCreateInfo inputAssembly { .topology = vk::PrimitiveTopology::eTriangleList };
	

	vk::PolygonMode pMode = vk::PolygonMode::eFill;	
	if		(renderingMode == LINE_MODE)  { pMode = vk::PolygonMode::eLine;  }
	else if (renderingMode == POINT_MODE) { pMode = vk::PolygonMode::ePoint; }



	vk::PipelineRasterizationStateCreateInfo rasterizer
	{		
		.depthClampEnable		 = vk::False,
		.rasterizerDiscardEnable = vk::False,
		.polygonMode			 = pMode,
		.cullMode			     = vk::CullModeFlagBits::eNone, // @note Culling
		.frontFace			     = vk::FrontFace::eClockwise,
		.depthBiasEnable		 = vk::False,
		.lineWidth				 = 1.0f							// @note Any line thicker than 1, needs the widelines gpu feature enabled
	};

	// ================================================================================ //

	vk::PipelineMultisampleStateCreateInfo multisampling
	{
		.rasterizationSamples = vk::SampleCountFlagBits::e1,
		.sampleShadingEnable  = vk::False
	};

	// ================================================================================ //

	// vk::PipelineColorBlendAttachmentState colorBlendAttachment
	// {
	// 	.blendEnable		 = vk::True,
	// 	.srcColorBlendFactor = vk::BlendFactor::eSrcAlpha,
	// 	.dstColorBlendFactor = vk::BlendFactor::eOneMinusSrcAlpha,
	// 	.colorBlendOp		 = vk::BlendOp::eAdd,
	// 	.srcAlphaBlendFactor = vk::BlendFactor::eOne,
	// 	.dstAlphaBlendFactor = vk::BlendFactor::eZero,
	// 	.alphaBlendOp		 = vk::BlendOp::eAdd,
	// 	.colorWriteMask		 = vk::ColorComponentFlagBits::eR | vk::ColorComponentFlagBits::eG | vk::ColorComponentFlagBits::eB | vk::ColorComponentFlagBits::eA,
	// };

	vk::PipelineColorBlendAttachmentState colorBlendAttachment
	{
		.blendEnable    = vk::False,
		.colorWriteMask = vk::ColorComponentFlagBits::eR | vk::ColorComponentFlagBits::eG | vk::ColorComponentFlagBits::eB | vk::ColorComponentFlagBits::eA,
	};

	vk::PipelineColorBlendStateCreateInfo colorBlending
	{
		.logicOpEnable   = vk::False,
		.logicOp		 = vk::LogicOp::eCopy,
		.attachmentCount = 1,
		.pAttachments    = &colorBlendAttachment
	};

	// ================================================================================ //

	
	vk::PipelineLayoutCreateInfo pipelineLayoutCreateInfo = 
	{
		.setLayoutCount			= 1,
		.pSetLayouts			= &*descriptorSetLayout,
		.pushConstantRangeCount	= 0,	
	};

	SHADER_PIPELINE_LAYOUT = vk::raii::PipelineLayout(LOGICAL_DEVICE, pipelineLayoutCreateInfo);

	// ================================================================================ //
	vk::PipelineDepthStencilStateCreateInfo depthStencil
	{
		.depthTestEnable       = vk::True,
		.depthWriteEnable      = vk::True,
		.depthCompareOp        = vk::CompareOp::eLess,
		.depthBoundsTestEnable = vk::False,
		.stencilTestEnable     = vk::False
	};


	vk::StructureChain<vk::GraphicsPipelineCreateInfo, vk::PipelineRenderingCreateInfo> pipelineCreateInfoChain
	{
		vk::GraphicsPipelineCreateInfo
		{
			.stageCount			 = 2,
			.pStages			 = shaderStages,
			.pVertexInputState   = &vertexInputInfo,
			.pInputAssemblyState = &inputAssembly,
			.pViewportState		 = &viewportState,
			.pRasterizationState = &rasterizer,
			.pMultisampleState   = &multisampling,
			.pDepthStencilState  = &depthStencil,
			.pColorBlendState    = &colorBlending,
			.pDynamicState		 = &dynamicState,
			.layout				 = SHADER_PIPELINE_LAYOUT,
			.renderPass			 = nullptr
		},

		vk::PipelineRenderingCreateInfo
		{
			.colorAttachmentCount	 = 1,
			.pColorAttachmentFormats = &SWAP_CHAIN_SURFACE_FORMAT.format,
			.depthAttachmentFormat	 = DEPTH_BUFFER.format
		}		
	};

	// ================================================================================ //

	vk::GraphicsPipelineCreateInfo &info = pipelineCreateInfoChain.get<vk::GraphicsPipelineCreateInfo>();

	SHADER_PIPELINE = vk::raii::Pipeline(LOGICAL_DEVICE, nullptr, info);	
}
 



// ================================================================================ // 	
// Synchronization Objects
// ================================================================================ // 	

std::vector<vk::raii::Semaphore> fVulkan::Synchronization_Objects::PRESENT_COMPLETE_SEMAPHORE{};
std::vector<vk::raii::Semaphore> fVulkan::Synchronization_Objects::RENDER_FINISHED_SEMAPHORE{};
std::vector<vk::raii::Fence>	 fVulkan::Synchronization_Objects::DRAW_FENCE{};

// ================================================================================ // 

void fVulkan::Synchronization_Objects::CREATE()
{
	assert(PRESENT_COMPLETE_SEMAPHORE.empty() && RENDER_FINISHED_SEMAPHORE.empty() && DRAW_FENCE.empty());

	for (size_t i = 0; i < SWAP_CHAIN_IMAGES.size(); i++)
	{
		RENDER_FINISHED_SEMAPHORE.emplace_back(LOGICAL_DEVICE, vk::SemaphoreCreateInfo());
	}

	for (size_t i = 0; i < MAX_FRAMES_IN_FLIGHT; i++)
	{
		PRESENT_COMPLETE_SEMAPHORE.emplace_back(vk::raii::Semaphore(LOGICAL_DEVICE, vk::SemaphoreCreateInfo()));
		DRAW_FENCE.emplace_back(vk::raii::Fence(LOGICAL_DEVICE, {.flags = vk::FenceCreateFlagBits::eSignaled}));
	}

	
}

void fVulkan::Synchronization_Objects::Clear()
{
	for (vk::raii::Semaphore &semaphore : Synchronization_Objects::PRESENT_COMPLETE_SEMAPHORE) { semaphore.clear(); }
	for (vk::raii::Semaphore &semaphore : Synchronization_Objects::RENDER_FINISHED_SEMAPHORE)  { semaphore.clear(); }
	for (vk::raii::Fence     &fence		: Synchronization_Objects::DRAW_FENCE)				   { fence.clear();		}
}







