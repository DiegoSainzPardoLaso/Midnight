#pragma once

#include "../Math/Vector.h"





// @note For debug objects
//
struct dVertex
{
	Vec3 position;
	Vec3 color;
};

// @note For GUIs 
//
struct gVertex
{
	Vec3 position;
	Vec3 color;
	Vec2 uv;
};

// @note Static Vertex
//
struct sVertex
{
	Vec3 position;
	Vec3 color;
	Vec3 normal;
	Vec2 uv;
};

// @note Animated Vertex
//
struct aVertex
{
	Vec3  position;
	Vec3  color;
	Vec3  normal;
	Vec2  uv;

	IVec4 influenceIndices;
	Vec4  weights;
};