// =====================================================================================
// Window Parameters
// =====================================================================================
#define WINDOW_MIN_SIZE           200
#define WINDOW_PIXEL_COMPENSATION 10
#define WINDOW_SNAP_COMPENSATION  8
#define DISABLE_WINDOWS_KEY_COMBINATIONS(a) a == VK_RWIN

// =====================================================================================
// Window Custom Events
// =====================================================================================
#define ME_MBITM 0xF095        // Click On Menu Item

#define SC_CMOVE 0xF012        // Moving the Window
#define SC_SCALE 0xF001        // Scaling Left Edge
#define SC_SCARE 0xF002        // Scaling Right Edge
#define SC_SCATE 0xF003        // Scaling Top Edge
#define SC_SCATL 0xF004        // Scaling Top Left Edge
#define SC_SCATR 0xF005        // Scaling Top Right Edge
#define SC_SCABE 0xF006        // Scaling Bottom Edge
#define SC_SCABL 0xF007        // Scaling Bottom Left Edge
#define SC_SCABR 0xF008        // Scaling Bottom Right Edge

// =====================================================================================
// Window Menu
// =====================================================================================
#define MENU_BAR_COLOR  0xe0e0e0e0
#define MENU_BAR_HEIGHT 60

#define MI_SCENE_NEW    0
#define MI_SCENE_SAVE   1
#define MI_SCENE_LOAD   2

#define MI_EDIT_UNDO    3
#define MI_EDIT_REDO    4
#define MI_EDIT_QUIT    5



enum WINDOW_STATE
{
    WINDOW_CLOSED,
    WINDOW_OPEN,
    WINDOW_MAXIMIZED,
    WINDOW_MINIMIZED,
    WINDOW_SNAPPED,
};

enum WINDOW_FLAGS
{
    RESIZING = 1 << 0,
};

enum CUSTOM_EVENTS
{
    CE_NONE,

    CE_MOVING,
    CE_SCALING_LEFT_WINDOW_EDGE,
    CE_SCALING_RIGHT_WINDOW_EDGE,
    CE_SCALING_TOP_WINDOW_EDGE,
    CE_SCALING_TOP_LEFT_WINDOW_EDGE,
    CE_SCALING_TOP_RIGHT_WINDOW_EDGE,
    CE_SCALING_BOTTOM_WINDOW_EDGE,
    CE_SCALING_BOTTOM_LEFT_WINDOW_EDGE,
    CE_SCALING_BOTTOM_RIGHT_WINDOW_EDGE,
};

struct Window
{
    HWND handle;
    HDC  hdc;

    HMENU menuBar;
    HMENU subMenu;

    Vec2 position;
    Vec2 dimensions;            

    Vec2 clientAreaDimensions;  // Use this for other frame buffer that are not the main one;
          
    Vec2 restoreDimensions;     // Dimensions Used when restoring the window size after going back from a maximize or snapped screen
    WINDOW_STATE state;

    uint32_t flags;
};


namespace fPlatform_Window_Win32
{
    Window* Create(int x, int y, int width, int height, const char *name);
    bool IsOpen(Window *&window);
    void SwapBuffers(Window *&widnow);
    bool Destroy(Window *&window);    
    
    Vec2 GetWindowPosition(HWND hwnd);
    Vec2 GetWindowDimensions(HWND hwnd);
    Vec2 GetClientAreaDimensions(HWND hwnd);
  
    void update_message_loop(HWND handle);    
    void update_custom_events(Window *&window);

    void update_window_shortcuts(Window *&window);

    void UpdateWindowTitle(Window *&window, const char *text);

    void ChangeToFullScreen(Window *&window);
    
    namespace Internal
    {
        inline CUSTOM_EVENTS CUSTOM_EVENT;

        LRESULT CALLBACK MainWinProc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam);  
        void AdjustWindowPositionAndDimensions(Window *&window, WINDOW_STATE windowState);
    }
}

namespace fPlatform_Win32
{
    Vec2 GetScreenResolution(HWND handle);
    Vec2 UpdateVirtualScreenDimensions();
    Vec4 UpdateCurrentMonitorVirtualScreenCoordinates(HWND handle);
    
    namespace Internal
    {
        inline int VIRTUAL_SCREEN_WIDTH;
        inline int VIRTUAL_SCREEN_HEIGHT;

        inline int CURRENT_MONITOR_VIRTUAL_X;
        inline int CURRENT_MONITOR_VIRTUAL_Y;
        inline int CURRENT_MONITOR_VIRTUAL_CX;
        inline int CURRENT_MONITOR_VIRTUAL_CY;

        inline int CURRENT_MONITOR_WIDTH;
        inline int CURRENT_MONITOR_HEIGHT;
    }

    // =======================================================
    // Used for when something occurs at the window level and 
    // I want to manage the result of that action elsewhere    
    // =======================================================
    //
    namespace InterestValues
    {
        inline bool  SCENE_MUST_BE_SAVED;
        inline char  SCENE_SAVE_PATH[MAX_PATH];

        inline bool  SCENE_MUST_BE_LOADED;
        inline char  SCENE_LOAD_PATH[MAX_PATH];

    }
}


namespace fPlatform_Input_Win32
{    
    void Initialize();
    void Update(Window*& window);
    void update_after_each_frame();    // @note I use this for the first key presses
    void Terminate();
    
    namespace Internal  
    {                 
        inline HCURSOR ORIGINAL_CURSOR;

        inline HHOOK keyboardHook{};
        LRESULT CALLBACK LowLevelKeyboardProc(const int code, const WPARAM wParam, const LPARAM lParam);
        
        
        
        
        // @todo
        void SetControllerProperty();
        // Called from the mainwinproc
        //
        void UpdateController(const unsigned char* data, const unsigned int size);
        void UpdateMouse(Window*& window);
        void UpdateKeys();     

    }
}


