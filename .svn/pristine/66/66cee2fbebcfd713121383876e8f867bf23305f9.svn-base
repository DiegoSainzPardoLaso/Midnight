void fPlatform_Input_Win32::Internal::UpdateMouse(Window*& win)
{       
    POINT p;
    GetCursorPos(&p);
    Mouse::GLOBAL_X = (float)p.x;
    Mouse::GLOBAL_Y = (float)p.y;


    // if (Mouse::Internal::SHOW_CURSOR) { SetCursor(Internal::ORIGINAL_CURSOR); }
    // else                              { SetCursor(NULL); }

}

