#include "Platform_Win32.h"


enum FileExplorerMode
{
    NEW,
    OPEN,
    SAVE
};

void AddMenus(Window*& win);
bool OpenFileExplorer(char *outPath, FileExplorerMode mode);

// =====================================================================================
// Key Inputs
// =====================================================================================
LRESULT CALLBACK fPlatform_Input_Win32::Internal::LowLevelKeyboardProc(const int code, const WPARAM wparam, const LPARAM lparam)
{        
    
    // don't process the message 
    //
    if (code < 0 || code != HC_ACTION) { return CallNextHookEx(Internal::keyboardHook, code, wparam, lparam); }
        
    KBDLLHOOKSTRUCT *kbdStruct = (KBDLLHOOKSTRUCT *)lparam;
    DWORD wVirtKey             = kbdStruct->vkCode;
    DWORD wScanCode            = kbdStruct->scanCode;


    if (DISABLE_WINDOWS_KEY_COMBINATIONS(kbdStruct->vkCode)) { return 1; }
    
    switch (wparam)
    {
        case WM_KEYDOWN:
        {
            Input::Internal::keys[wVirtKey] = 1;                         
        } break;

        case WM_KEYUP:      
        {
            Input::Internal::keys[wVirtKey] = 0; 
            
            // @note This is for cases when I press ALT and another key and then I let go of the alt key in the first place this resets the inputs
            //
            if (wVirtKey == KEY_LEFT_ALT || wVirtKey == KEY_RIGHT_ALT) { fInput::ClearAllInputState();  }
        } break;

        case WM_SYSKEYDOWN: 
        {
            // @note The way I decided to handle the Alt key is to add the key combinations to the internal keys array and I also Clear All Input State just in case
            //            
            fInput::ClearAllInputState();
            Input::Internal::keys[wScanCode + 105] = 1;            
            return 0; 
        } break;

        case WM_SYSKEYUP: 
        {
            fInput::ClearAllInputState();
            Input::Internal::keys[wScanCode + 105] = 0;             
        } break;        
    }
    
    
    return CallNextHookEx(Internal::keyboardHook, code, wparam, lparam);
}


LRESULT CALLBACK fPlatform_Window_Win32::Internal::MainWinProc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
{    
    switch (msg)
    {
        // =====================================================================================
        // Mouse
        // =====================================================================================                       
        case WM_LBUTTONDOWN: 
        {
            Mouse::BUTTON_LEFT = I_STATE::PRESSED; 
        } break;

        case WM_LBUTTONUP:
        {
            Mouse::BUTTON_LEFT = I_STATE::RELEASED;
            ReleaseCapture();
        } break;

        case WM_NCLBUTTONUP:
        {
            Mouse::BUTTON_LEFT = I_STATE::RELEASED;
            ReleaseCapture();
        } break;

        case WM_NCLBUTTONDBLCLK:
        {
            // Window* win = (Window*)GetWindowLongPtr(hwnd, GWLP_USERDATA);
            // if (win->state == WINDOW_STATE::WINDOW_MAXIMIZED)
            // {
            //     ShowWindow(hwnd, SW_SHOWNORMAL);
            //     win->state = WINDOW_OPEN;
            // }
            // else
            // {
            //     win->restoreDimensions = win->dimensions;
            //     ShowWindow(hwnd, SW_MAXIMIZE);
            //     win->state = WINDOW_MAXIMIZED;
            // }
            // 
            // win->position   = GetWindowPosition(hwnd);
            // win->dimensions = GetWindowDimensions(hwnd);
            // glViewport(0, 0, (int)win->dimensions.width, (int)win->dimensions.height);
        }break;

        case WM_NCRBUTTONUP: 
        { 
            Mouse::BUTTON_RIGHT = I_STATE::RELEASED; 
        } break;

        case WM_RBUTTONDOWN: 
        {
            Mouse::BUTTON_RIGHT = I_STATE::PRESSED;  
            SetCapture(hwnd);            
        } break;
                                                          
        case WM_RBUTTONUP:   
        {            
            Mouse::BUTTON_RIGHT = I_STATE::RELEASED; 
            ReleaseCapture();
        } break;
                                                          
        case WM_MBUTTONDOWN:
        {
            SetCapture(hwnd);
            Mouse::BUTTON_SCROLL_WHEEL = I_STATE::PRESSED;  
        } break;

        case WM_MBUTTONUP:   
        {
            Mouse::BUTTON_SCROLL_WHEEL = I_STATE::RELEASED; 
            ReleaseCapture();
        } break;

        case WM_MOUSEMOVE:
        {            
            Mouse::X = (float)GET_X_LPARAM(lparam);
            Mouse::Y = (float)GET_Y_LPARAM(lparam);

            // if (WRAP_MOUSE_X_RIGHT) 
            // {
            //     Window *win = (Window *)GetWindowLongPtr(hwnd, GWLP_USERDATA);
            //     Mouse::X = win->position.x + 1; 
            //     SetCursorPos((int)Mouse::X, (int)Mouse::Y);
            //     SetCapture(hwnd);
            // }
            // 

//             // if (WRAP_MOUSE_X_LEFT)  
            // {
            //     Window *win = (Window *)GetWindowLongPtr(hwnd, GWLP_USERDATA);
            //     Mouse::X = win->dimensions.width - 100; 
            //     SetCursorPos((int)Mouse::X, (int)Mouse::Y);
            //     SetCapture(hwnd);
            // }
            

        } break;
       
        // =====================================================================================
        // Controller (Works 'cause I registered the controller at the beginning of the engine)
        // =====================================================================================                 
        case WM_INPUT:
        {
            Controller::CONNECTED = true;
            UINT dwSize{};

            GetRawInputData((HRAWINPUT)lparam, RID_INPUT, NULL, &dwSize, sizeof(RAWINPUTHEADER));
            LPBYTE lpb = new BYTE[dwSize];

            if (GetRawInputData((HRAWINPUT)lparam, RID_INPUT, lpb, &dwSize, sizeof(RAWINPUTHEADER)) != dwSize)
                OutputDebugString(TEXT("GetRawInputData does not return correct size !\n"));

            RAWINPUT *raw = (RAWINPUT *)lpb;

            if (raw->header.dwType == RIM_TYPEHID)
            {                       
                unsigned int size = raw->data.hid.dwCount * raw->data.hid.dwSizeHid;
                fPlatform_Input_Win32::Internal::UpdateController(raw->data.hid.bRawData, size);
                //fOSM_Input::Internal::SetControllerProperty();

            }

            delete[] lpb;
            return 0;
        } break;

        // =====================================================================================
        // Window Regular Messages
        // =====================================================================================
        case WM_CREATE:
        {
            //Window *win = (Window *)GetWindowLongPtr(hwnd, GWLP_USERDATA);            
            fPlatform_Win32::UpdateVirtualScreenDimensions();
            fPlatform_Win32::UpdateCurrentMonitorVirtualScreenCoordinates(hwnd);            

            fPlatform_Input_Win32::Internal::ORIGINAL_CURSOR = GetCursor();

        } break;

        case WM_SIZE:
        {               
            // @note I handle all the moving and scaling the window, but there are some events like the aerosnap, that are just handled internally,
            // Windows never sends a message related to those, It just sends a WM_Resize, so as I'm the one handling all the window behaviour
            // the only option left for an WM_Size event to appear is that I'm changing the window size using some KEY combinations like WIN + Arrow
            //
            Window* win = (Window*)GetWindowLongPtr(hwnd, GWLP_USERDATA);
            if (Internal::CUSTOM_EVENT == CUSTOM_EVENTS::CE_NONE)
            {                                
                win->position   = GetWindowPosition(hwnd);
                win->dimensions = GetWindowDimensions(hwnd);
            }

            win->clientAreaDimensions = GetClientAreaDimensions(hwnd);

        } break;
               
        case WM_WINDOWPOSCHANGING:
        {
            // @note I'm gonna use this to check things like the window changing from one screen to another
            // 
            Vec2 p   = fPlatform_Window_Win32::GetWindowPosition(hwnd);           
            Vec2 dim = fPlatform_Win32::GetScreenResolution(hwnd);

            WINDOWPLACEMENT wp{};
            wp.length = sizeof(WINDOWPLACEMENT);
            GetWindowPlacement(hwnd, &wp);            

            fPlatform_Win32::Internal::CURRENT_MONITOR_WIDTH  = (int)dim.width;
            fPlatform_Win32::Internal::CURRENT_MONITOR_HEIGHT = (int)dim.height;
        } break;

        case WM_DESTROY:
        {
            Window *win = (Window *)GetWindowLongPtr(hwnd, GWLP_USERDATA);
            win->state  = WINDOW_CLOSED;
            PostQuitMessage(0);

        } break;

        case WM_KILLFOCUS:
        {
            ReleaseCapture();
            fInput::ClearAllInputState();
        } break;

        // =====================================================================================
        // Window Menu Items
        // =====================================================================================
        case WM_COMMAND:
        {                        
            switch (LOWORD(wparam))
            {
                case MI_SCENE_SAVE: { fPlatform_Win32::InterestValues::SCENE_MUST_BE_SAVED  = OpenFileExplorer(fPlatform_Win32::InterestValues::SCENE_SAVE_PATH, FileExplorerMode::SAVE); } break;
                case MI_SCENE_LOAD: { fPlatform_Win32::InterestValues::SCENE_MUST_BE_LOADED = OpenFileExplorer(fPlatform_Win32::InterestValues::SCENE_LOAD_PATH, FileExplorerMode::OPEN); } break;

                case MI_EDIT_QUIT:
                {
                    Window *win = (Window *)GetWindowLongPtr(hwnd, GWLP_USERDATA);
                    win->state = WINDOW_CLOSED;
                    PostQuitMessage(0);
                }break;
            }

            
            
        }break;
                        
        // =====================================================================================
        // SYSCommand Custom Behaviour
        // =====================================================================================        
        case WM_SYSCOMMAND:
        {                          
            // @note I handle the SysCommand Messages myself, so the window doesnt get stuck while resizing or moving
            //
            Window* win = (Window*)GetWindowLongPtr(hwnd, GWLP_USERDATA);
            
            if (wparam == SC_CMOVE)                                                                 
            {                
                fPlatform_Win32::GetScreenResolution(hwnd);                
                fPlatform_Win32::UpdateCurrentMonitorVirtualScreenCoordinates(hwnd);

                Internal::CUSTOM_EVENT = CE_MOVING; 
                Mouse::BUTTON_LEFT = I_STATE::PRESSED;                    
                SetCapture(hwnd);                               
            }
            else if (wparam == SC_SCALE)
            {                
                Internal::CUSTOM_EVENT = CE_SCALING_LEFT_WINDOW_EDGE;
                Mouse::BUTTON_LEFT = I_STATE::PRESSED;
                SetCapture(hwnd);
            }
            else if (wparam == SC_SCARE)                                                            
            {             
                Internal::CUSTOM_EVENT = CE_SCALING_RIGHT_WINDOW_EDGE;
                Mouse::BUTTON_LEFT = I_STATE::PRESSED;
                SetCapture(hwnd);
            }
            else if (wparam == SC_SCATE)    
            {             
                Internal::CUSTOM_EVENT = CE_SCALING_TOP_WINDOW_EDGE;                                                                 
                Mouse::BUTTON_LEFT = I_STATE::PRESSED;
                SetCapture(hwnd);
            }
            else if (wparam == SC_SCATL) 
            {             
                Internal::CUSTOM_EVENT = CE_SCALING_TOP_LEFT_WINDOW_EDGE;   
                Mouse::BUTTON_LEFT = I_STATE::PRESSED;
                SetCapture(hwnd);
            }
            else if (wparam == SC_SCATR) 
            {             
                Internal::CUSTOM_EVENT = CE_SCALING_TOP_RIGHT_WINDOW_EDGE;  
                Mouse::BUTTON_LEFT = I_STATE::PRESSED;
                SetCapture(hwnd);
            }
            else if (wparam == SC_SCABE)    
            {             
                Internal::CUSTOM_EVENT = CE_SCALING_BOTTOM_WINDOW_EDGE;          
                Mouse::BUTTON_LEFT = I_STATE::PRESSED;
                SetCapture(hwnd);
            }
            else if (wparam == SC_SCABL)    
            {             
                Internal::CUSTOM_EVENT = CE_SCALING_BOTTOM_LEFT_WINDOW_EDGE;     
                Mouse::BUTTON_LEFT = I_STATE::PRESSED;
                SetCapture(hwnd);
            }
            else if (wparam == SC_SCABR)    
            {             
                Internal::CUSTOM_EVENT = CE_SCALING_BOTTOM_RIGHT_WINDOW_EDGE;    
                Mouse::BUTTON_LEFT = I_STATE::PRESSED;
                SetCapture(hwnd);
            }
            else if (wparam == SC_MINIMIZE) 
            {
                ShowWindow(hwnd, SW_SHOWMINIMIZED); 
            }
            else if (wparam == SC_MAXIMIZE) 
            {
                if (win->state != WINDOW_STATE::WINDOW_SNAPPED) { win->restoreDimensions = GetWindowDimensions(hwnd); }
                Internal::AdjustWindowPositionAndDimensions(win, WINDOW_STATE::WINDOW_MAXIMIZED);                 
            }
            else if (wparam == SC_RESTORE)  
            {
                Internal::AdjustWindowPositionAndDimensions(win, WINDOW_STATE::WINDOW_OPEN);     
                if (win->position.y <= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y)
                {
                    win->position.y = (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y;                                        
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
            }
            else if (wparam == SC_CLOSE)    
            {
                fPlatform_Window_Win32::Destroy(win); 
            }                        
            else if (wparam == SC_KEYMENU)  // @note This disables the ALT + Key default configurations (No menu selections for example)
            {                             
            }
            else if (ME_MBITM)
            {
                DefWindowProc(hwnd, msg, wparam, lparam);
            }


        } break;              


        default: 
        {
            // @note I keep this as the default cause it chooses the Pixel format when creating the window among other things
            //
            return DefWindowProc(hwnd, msg, wparam, lparam); 
        } break;
    }
    
    return NULL;
}


void fPlatform_Window_Win32::update_message_loop(HWND handle)
{    
    MSG msg;
    while (PeekMessage(&msg, handle, NULL, NULL, PM_REMOVE))
    {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }    

    if (VSYNC && CURRENT_RENDERING_API == OPENGL) { ((BOOL(WINAPI *)(int))wglGetProcAddress("wglSwapIntervalEXT"))(1); }
    else if (    CURRENT_RENDERING_API == OPENGL) { ((BOOL(WINAPI *)(int))wglGetProcAddress("wglSwapIntervalEXT"))(0); }
}

void fPlatform_Window_Win32::update_custom_events(Window*& win)
{
    static bool doneOnce = false;
    static Vec2 startingMousePosWhileDragging = { 0, 0 };
    static Vec2 windowStartPosition           = { 0, 0 };
    static Vec2 windowStartDimensions         = { 0, 0 };

    switch (Internal::CUSTOM_EVENT)
    {
        case CE_MOVING:
        {
            if (Mouse::BUTTON_LEFT && !doneOnce)
            {
                if (win->state == WINDOW_STATE::WINDOW_MAXIMIZED || win->state == WINDOW_STATE::WINDOW_SNAPPED)
                {
                    win->state      = WINDOW_STATE::WINDOW_OPEN;
                    win->dimensions = win->restoreDimensions;
                    win->position.x = Mouse::GLOBAL_X - win->dimensions.width / 2;
                    win->position.y = Mouse::GLOBAL_Y - WINDOW_PIXEL_COMPENSATION; 

                    // @note Doing this with a windowplacement removes the animation of ShowWindow
                    //
                    WINDOWPLACEMENT wp{};
                    wp.length  = sizeof(WINDOWPLACEMENT);
                    wp.showCmd = SW_RESTORE;
                    wp.rcNormalPosition.left   = (LONG)win->position.x;
                    wp.rcNormalPosition.top    = (LONG)win->position.y;
                    wp.rcNormalPosition.right  = (LONG)win->position.x + (LONG)win->dimensions.width;
                    wp.rcNormalPosition.bottom = (LONG)win->position.y + (LONG)win->dimensions.height;

                    SetWindowPlacement(win->handle, &wp);                    
                }
               
                startingMousePosWhileDragging = { Mouse::GLOBAL_X, Mouse::GLOBAL_Y };
                windowStartPosition = { (float)win->position.x, (float)win->position.y };
                doneOnce = true;
            }

            Vec2 curp   = { Mouse::GLOBAL_X, Mouse::GLOBAL_Y };
            Vec2 offset = curp - startingMousePosWhileDragging + windowStartPosition;
 
            win->position = offset;
            SetWindowPos(win->handle, NULL, (int)offset.x, (int)offset.y, (int)win->dimensions.width, (int)win->dimensions.height, SWP_NOSIZE);


            if (!Mouse::BUTTON_LEFT)
            {
                Internal::CUSTOM_EVENT = CE_NONE;
                doneOnce = false;

                // Check if the window is outside the screen
                //
                if (win->position.y < fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y)
                {
                    win->position.y = (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y;
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }

                fPlatform_Win32::UpdateCurrentMonitorVirtualScreenCoordinates(win->handle);
                
                //===================================================================
                // WINDOW SNAPPING
                //===================================================================
                //                                
                // TOP LEFT
                if (Mouse::GLOBAL_Y <= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y && Mouse::GLOBAL_X <= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_X)                                 
                {                    
                    win->restoreDimensions = win->dimensions;
                    win->state = WINDOW_STATE::WINDOW_SNAPPED;
                    int w =  fPlatform_Win32::Internal::CURRENT_MONITOR_WIDTH                                                   / 2;
                    int h = (fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y) / 2;

                    win->position   = { (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_X - WINDOW_SNAP_COMPENSATION, (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y };
                    win->dimensions = { (float)w,                                                                    (float)h + WINDOW_SNAP_COMPENSATION };
                                        
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
                // TOP RIGHT
                else if (Mouse::GLOBAL_Y <= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y && Mouse::GLOBAL_X >= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CX - 2)                       
                {
                    win->restoreDimensions = win->dimensions;
                    win->state = WINDOW_STATE::WINDOW_SNAPPED;
                    int x =  fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CX - fPlatform_Win32::Internal::CURRENT_MONITOR_WIDTH      / 2;
                    int w =  fPlatform_Win32::Internal::CURRENT_MONITOR_WIDTH                                                   / 2;
                    int h = (fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y) / 2;

                    win->position   = { (float)x,                            (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y };
                    win->dimensions = { (float)w + WINDOW_SNAP_COMPENSATION, (float)h + WINDOW_SNAP_COMPENSATION              };
                    
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
                // BOTTOM LEFT
                else if (Mouse::GLOBAL_Y >= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - 2 && Mouse::GLOBAL_X <= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_X)                       
                {                 
                    win->restoreDimensions = win->dimensions;
                    win->state = WINDOW_STATE::WINDOW_SNAPPED;
                    int y =  fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_HEIGHT     / 2;
                    int h = (fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y) / 2;

                    win->position   = { (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_X - WINDOW_SNAP_COMPENSATION, (float)y + WINDOW_SNAP_COMPENSATION };
                    win->dimensions = { (float)fPlatform_Win32::Internal::CURRENT_MONITOR_WIDTH / 2,                            (float)h                            };
                    
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
                // BOTTOM RIGHT 
                else if (Mouse::GLOBAL_Y >= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - 2 && Mouse::GLOBAL_X >= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CX - 2)                  
                {                
                    win->restoreDimensions = win->dimensions;
                    win->state = WINDOW_STATE::WINDOW_SNAPPED;
                    int x =  fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CX - fPlatform_Win32::Internal::CURRENT_MONITOR_WIDTH      / 2;
                    int y =  fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_HEIGHT     / 2;
                    int h = (fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y) / 2;


                    win->position   = { (float)x + WINDOW_SNAP_COMPENSATION,              (float)y + WINDOW_SNAP_COMPENSATION };
                    win->dimensions = { (float)fPlatform_Win32::Internal::CURRENT_MONITOR_WIDTH / 2, (float)h                            };
                    
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
                // TOP
                else if (Mouse::GLOBAL_Y <= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y)                                                                                                   
                {
                    win->restoreDimensions = win->dimensions;
                    ShowWindow(win->handle, SW_MAXIMIZE);
                    win->state      = WINDOW_MAXIMIZED;
                    win->position   = GetWindowPosition(win->handle);
                    win->dimensions = GetWindowDimensions(win->handle);
                    
                }
                // LEFT
                else if (Mouse::GLOBAL_X <= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_X  + 2)
                {             
                    win->restoreDimensions = win->dimensions;
                    win->state = WINDOW_STATE::WINDOW_SNAPPED;
                    
                    int h = fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y;
                    
                    win->position   = { (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_X - WINDOW_SNAP_COMPENSATION, (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y };
                    win->dimensions = { (float)fPlatform_Win32::Internal::CURRENT_MONITOR_WIDTH / 2.0f,                         (float)h + WINDOW_SNAP_COMPENSATION              };
                                        
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
                // RIGHT
                else if (Mouse::GLOBAL_X >= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CX - 2)
                {         
                    win->restoreDimensions = win->dimensions;
                    win->state = WINDOW_STATE::WINDOW_SNAPPED;
                    
                    int x = fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CX - fPlatform_Win32::Internal::CURRENT_MONITOR_WIDTH  / 2;
                    int w = fPlatform_Win32::Internal::CURRENT_MONITOR_WIDTH                                               / 2;
                    int h = fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y;

                    win->position   = { (float)x,                            (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y };
                    win->dimensions = { (float)w + WINDOW_SNAP_COMPENSATION, (float)h + WINDOW_SNAP_COMPENSATION              };
                    
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
            }

        }break;

        case CE_SCALING_RIGHT_WINDOW_EDGE:
        {                        
            // @note Don't really know why, but the window jumps about 10 px to the left when grabbing it, this compensates it.
            //
            float nX = Mouse::GLOBAL_X - win->position.x + WINDOW_PIXEL_COMPENSATION;

            if (!Mouse::BUTTON_LEFT) { Internal::CUSTOM_EVENT = CE_NONE; }
            if (nX <= WINDOW_MIN_SIZE) { nX = WINDOW_MIN_SIZE; }
            
            win->dimensions = { nX, win->dimensions.y };              
            SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)nX, (int)win->dimensions.height, NULL);

        }break;

        case CE_SCALING_BOTTOM_RIGHT_WINDOW_EDGE:
        {
            // @note Don't really know why, but the window jumps about 10 px to the left when grabbing it, this compensates it.
            //
            Vec2 mp = { Mouse::GLOBAL_X , Mouse::GLOBAL_Y };
            Vec2 nP = mp - win->position;
            nP.x += WINDOW_PIXEL_COMPENSATION;
            nP.y += WINDOW_PIXEL_COMPENSATION;

            if (nP.x <= WINDOW_MIN_SIZE) { nP.x = WINDOW_MIN_SIZE; }
            if (nP.y <= WINDOW_MIN_SIZE) { nP.y = WINDOW_MIN_SIZE; }

            win->dimensions = { nP.width, nP.height };            
            SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)nP.width, (int)nP.height, NULL);

            if (!Mouse::BUTTON_LEFT) 
            {
                Internal::CUSTOM_EVENT = CE_NONE; 

                if (Mouse::GLOBAL_Y >= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - 1)
                {
                    win->position.y        = (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y;
                    win->dimensions.height = (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y + 8.0f;                    
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
            }

        }break;

        case CE_SCALING_BOTTOM_WINDOW_EDGE:
        {
            // @note Don't really know why, but the window jumps about 10 px to the left when grabbing it, this compensates it.
            //            
            float nP = Mouse::GLOBAL_Y - win->position.y + WINDOW_PIXEL_COMPENSATION;
            if (nP <= WINDOW_MIN_SIZE) { nP = WINDOW_MIN_SIZE; }

            
            win->dimensions = { win->dimensions.width, nP };            
            SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)nP, NULL);

            if (!Mouse::BUTTON_LEFT)  
            {
                Internal::CUSTOM_EVENT = CE_NONE;  

                if (Mouse::GLOBAL_Y >= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - 1)
                {
                    win->position.y        = (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y;
                    win->dimensions.height = (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y + 8.0f;                    
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
            }


        }break;

        case CE_SCALING_BOTTOM_LEFT_WINDOW_EDGE:
        {
            if (!doneOnce)
            {
                windowStartPosition = win->position;
                windowStartDimensions = win->dimensions;
                doneOnce = true;
            }

            Vec2 mp  = { Mouse::GLOBAL_X , Mouse::GLOBAL_Y };
            Vec2 dt  = windowStartPosition - mp;  

            float fx = mp.x - WINDOW_PIXEL_COMPENSATION;
            float fH = mp.height - windowStartPosition.y + WINDOW_PIXEL_COMPENSATION;
            float fW = windowStartDimensions.width + dt.x + WINDOW_PIXEL_COMPENSATION;


            // @note This prevents the window from moving right if the with reaches the mimimum window size
            //
            if (fx >= (windowStartPosition.x + windowStartDimensions.width - WINDOW_MIN_SIZE)) { fx = windowStartPosition.x + windowStartDimensions.width - WINDOW_MIN_SIZE;}
            if (fW <= WINDOW_MIN_SIZE) { fW = WINDOW_MIN_SIZE; }
            if (fH <= WINDOW_MIN_SIZE) { fH = WINDOW_MIN_SIZE; }

            win->position   = { fx, win->position.y };
            win->dimensions = { fW, fH };                                    
            SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);

            if (!Mouse::BUTTON_LEFT)
            {
                windowStartPosition = { 0,0 };
                windowStartDimensions = { 0, 0 };
                Internal::CUSTOM_EVENT = CE_NONE;
                doneOnce = false;


                if (Mouse::GLOBAL_Y >= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - 1)
                {
                    win->position.y = (float)fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y;
                    win->dimensions.height = fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y + 8.0f;                    
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
            }
        } break;

        case CE_SCALING_LEFT_WINDOW_EDGE:
        {
            if (!doneOnce)
            {
                windowStartPosition = win->position;
                windowStartDimensions = win->dimensions;
                doneOnce = true;
            }

            Vec2 mp = { Mouse::GLOBAL_X , Mouse::GLOBAL_Y };
            Vec2 dt = windowStartPosition - mp;

            float fx = mp.x - WINDOW_PIXEL_COMPENSATION;            
            float fW = windowStartDimensions.width + dt.x + WINDOW_PIXEL_COMPENSATION;

            // @note This prevents the window from moving right if the with reaches the mimimum window size
            //
            if (fx >= (windowStartPosition.x + windowStartDimensions.width - WINDOW_MIN_SIZE)) { fx = windowStartPosition.x + windowStartDimensions.width - WINDOW_MIN_SIZE; }
            if (fW <= WINDOW_MIN_SIZE) { fW = WINDOW_MIN_SIZE; }

            win->position   = { fx, win->position.y };
            win->dimensions = { fW, win->dimensions.height };            
            SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);

            if (!Mouse::BUTTON_LEFT)
            {
                windowStartPosition = { 0,0 };
                windowStartDimensions = { 0, 0 };
                Internal::CUSTOM_EVENT = CE_NONE;
                doneOnce = false;
            }
        } break;

        case CE_SCALING_TOP_WINDOW_EDGE:
        {
            if (!doneOnce)
            {
                windowStartPosition   = win->position;               
                windowStartDimensions = win->dimensions;                
                doneOnce = true;
            }
            
            float dt = windowStartPosition.y - Mouse::GLOBAL_Y;

            float fY = Mouse::GLOBAL_Y;
            float fH = windowStartDimensions.y + dt;
            
            if (fY >= (windowStartPosition.y + windowStartDimensions.height - WINDOW_MIN_SIZE)) { fY = windowStartPosition.y + windowStartDimensions.height - WINDOW_MIN_SIZE; }
            if (fH <= WINDOW_MIN_SIZE) { fH = WINDOW_MIN_SIZE; }            
            win->position   = { win->position.x,       fY};
            win->dimensions = { win->dimensions.width, fH };
            
            SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);

            if (!Mouse::BUTTON_LEFT)
            {
                windowStartPosition    = { 0, 0 };
                windowStartDimensions  = { 0, 0 };
                Internal::CUSTOM_EVENT = CE_NONE;
                doneOnce = false;

                if (Mouse::GLOBAL_Y <= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y + 1)
                {                    
                    win->dimensions.height = fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y + 8.0f;                    
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
            }

        }break;

        case CE_SCALING_TOP_LEFT_WINDOW_EDGE:
        {
            if (!doneOnce)
            {
                windowStartPosition = win->position;         
                windowStartDimensions = win->dimensions;                
                doneOnce = true;
            }

            Vec2 mp = { Mouse::GLOBAL_X, Mouse::GLOBAL_Y };
            Vec2 dt = windowStartPosition - mp;

            float fx = mp.x - WINDOW_PIXEL_COMPENSATION;
            float fY = Mouse::GLOBAL_Y;
            float fW = windowStartDimensions.width + dt.x + WINDOW_PIXEL_COMPENSATION;;
            float fH = windowStartDimensions.y + dt.y;

            if (fx >= (windowStartPosition.x + windowStartDimensions.width  - WINDOW_MIN_SIZE)) { fx = windowStartPosition.x + windowStartDimensions.width  - WINDOW_MIN_SIZE; }
            if (fY >= (windowStartPosition.y + windowStartDimensions.height - WINDOW_MIN_SIZE)) { fY = windowStartPosition.y + windowStartDimensions.height - WINDOW_MIN_SIZE; }
            if (fW <= WINDOW_MIN_SIZE) { fW = WINDOW_MIN_SIZE; }
            if (fH <= WINDOW_MIN_SIZE) { fH = WINDOW_MIN_SIZE; }

            win->position   = { fx, fY };
            win->dimensions = { fW, fH };
            
            SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);

            if (!Mouse::BUTTON_LEFT)
            {
                windowStartPosition = { 0, 0 };
                windowStartDimensions = { 0, 0 };
                Internal::CUSTOM_EVENT = CE_NONE;
                doneOnce = false;

                if (Mouse::GLOBAL_Y <= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y + 1)
                {
                    win->dimensions.height = fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y + 8.0f;                    
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
            }

        }break;

        case CE_SCALING_TOP_RIGHT_WINDOW_EDGE:
        {
            if (!doneOnce)
            {
                windowStartPosition = win->position;
                windowStartDimensions = win->dimensions;
                doneOnce = true;
            }

            Vec2 mp = { Mouse::GLOBAL_X, Mouse::GLOBAL_Y };
            Vec2 dt = windowStartPosition - mp;
            
            float fY = mp.y;
            float fW = mp.x - windowStartPosition.x + WINDOW_PIXEL_COMPENSATION;
            float fH = windowStartDimensions.y + dt.y;

            if (fY >= (windowStartPosition.y + windowStartDimensions.height - WINDOW_MIN_SIZE)) { fY = windowStartPosition.y + windowStartDimensions.height - WINDOW_MIN_SIZE; }
            if (fW <= WINDOW_MIN_SIZE) { fW = WINDOW_MIN_SIZE; }
            if (fH <= WINDOW_MIN_SIZE) { fH = WINDOW_MIN_SIZE; }

            win->position   = { win->position.x, fY };
            win->dimensions = { fW, fH};
            
            SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);

            if (!Mouse::BUTTON_LEFT)
            {
                windowStartPosition    = { 0, 0 };
                windowStartDimensions  = { 0, 0 };
                Internal::CUSTOM_EVENT = CE_NONE;
                doneOnce = false;

                if (Mouse::GLOBAL_Y <= fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y + 1)
                {
                    win->dimensions.height = fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_CY - fPlatform_Win32::Internal::CURRENT_MONITOR_VIRTUAL_Y + 8.0f;                    
                    SetWindowPos(win->handle, NULL, (int)win->position.x, (int)win->position.y, (int)win->dimensions.width, (int)win->dimensions.height, NULL);
                }
            }

        }break;
    }
}

void fPlatform_Window_Win32::update_window_shortcuts(Window *&window)
{
    if (Input::Key_Left_Ctrl && Input::Key_Left_Shift && fInput::FirstPress(KEY_S)) { Internal::MainWinProc(window->handle, WM_COMMAND, MI_SCENE_SAVE, 0); }
    if (Input::Key_Left_Ctrl && fInput::FirstPress(KEY_O))                          { Internal::MainWinProc(window->handle, WM_COMMAND, MI_SCENE_LOAD, 0); }
    // if (Input::Key_F12)                                                { ChangeToFullScreen(window); }
}


void fPlatform_Window_Win32::UpdateWindowTitle(Window *&window, const char *text)
{    
    SetWindowTextA(window->handle, text);
}

// @FIX_ME
//
void fPlatform_Window_Win32::ChangeToFullScreen(Window *&window)
{        
    DEVMODE dmSettings{};

    // Get the current display settings. 
    //
    if (!EnumDisplaySettingsW(NULL, ENUM_CURRENT_SETTINGS, &dmSettings))
    {        
        MessageBox(NULL, L"Could Not Enum Display Settings", L"Error", MB_OK);
        return;
    }
    
    
    dmSettings.dmPelsWidth  = GetSystemMetrics(SM_CXFULLSCREEN); // Desired Screen Width
    dmSettings.dmPelsHeight = GetSystemMetrics(SM_CYFULLSCREEN); // Desired Screen Height
    dmSettings.dmFields     = DM_PELSWIDTH | DM_PELSHEIGHT;	     // Set the flags saying we're changing the Screen Width and Height

    // This function actually changes the screen to full screen
    // CDS_FULLSCREEN Gets Rid Of Start Bar.
    // We always want to get a result from this function to check if we failed
    //
    int result = ChangeDisplaySettings(&dmSettings, CDS_FULLSCREEN);

    // Check if we didn't receive a good return message From the function
    //
    if (result != DISP_CHANGE_SUCCESSFUL)
    {
        // Display the error message and quit the program
        MessageBox(NULL, L"Display Mode Not Compatible", L"Error", MB_OK);
        PostQuitMessage(0);
    }
    
}


Window* fPlatform_Window_Win32::Create(int x, int y, int width, int height, const char* name)
{        
    SetProcessDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);


    wchar_t wtext[20];
    mbstowcs(wtext, name, strlen(name) + 1);
    LPWSTR windowName   = wtext;
    
 
    WNDCLASSEX wndClass{};
    wndClass.cbSize        = sizeof(WNDCLASSEX);
    wndClass.lpszClassName = windowName;
    wndClass.lpszMenuName  = windowName;
    wndClass.lpfnWndProc   = Internal::MainWinProc;

    
    if (!RegisterClassEx(&wndClass))
    {
        MessageBox(NULL, L"Failed To Create Window Class", windowName, MB_ICONERROR);        
        return nullptr;
    }

    RECT rc = { x, y, width, height };
    AdjustWindowRect(&rc, WS_OVERLAPPEDWINDOW | CS_HREDRAW | CS_VREDRAW, false);

    Window* win               = new Window();
    win->state                = WINDOW_OPEN;
    win->position             = { (float)x, (float)y };
    win->dimensions           = { (float)rc.right - rc.left, (float)rc.bottom - rc.top };    
    win->restoreDimensions    = win->dimensions;
    win->clientAreaDimensions = win->dimensions;
    
    
    win->handle = CreateWindowEx
    (
        NULL,
        windowName,
        windowName,
        WS_OVERLAPPEDWINDOW | CS_HREDRAW | CS_VREDRAW,
        (int)win->position.x,       (int)win->position.y,
        (int)win->dimensions.width, (int)win->dimensions.height,
        NULL, NULL, NULL, NULL
    );

    SetWindowLongPtr(win->handle, GWLP_USERDATA, (LONG_PTR)win);

   
    if (CURRENT_RENDERING_API == OPENGL)  
    {
        // ===================================================================================
        // Initialize OPENGL - Taken from Dav1dd's repo on how to initialize Glad
        // ===================================================================================
        HDC hdc = GetDC(win->handle);
        if (!hdc)
        {
            MessageBox(win->handle, L"Failed To Get Device Context", windowName, MB_ICONERROR);
            ReleaseDC(win->handle, hdc);
            DestroyWindow(win->handle);
            throw std::runtime_error::exception();
        }

        PIXELFORMATDESCRIPTOR pfd{};
        pfd.nSize = sizeof(PIXELFORMATDESCRIPTOR);
        pfd.dwFlags = PFD_DOUBLEBUFFER | PFD_SUPPORT_OPENGL | PFD_DRAW_TO_WINDOW;
        pfd.iPixelType = PFD_TYPE_RGBA;
        pfd.cColorBits = 32;
        pfd.cDepthBits = 32;
        pfd.iLayerType = PFD_MAIN_PLANE;

        int format = ChoosePixelFormat(hdc, &pfd);
        if (format == 0 || SetPixelFormat(hdc, format, &pfd) == FALSE)
        {
            ReleaseDC(win->handle, hdc);
            DestroyWindow(win->handle);
            MessageBox(NULL, L"Failed to set a compatible pixel format!", windowName, MB_ICONERROR);
            return nullptr;
        }

        // Create and enable a temporary (helper) opengl context:
        //
        HGLRC tempContext = NULL;
        if (NULL == (tempContext = wglCreateContext(hdc))) 
        {
            ReleaseDC(win->handle, hdc);
            DestroyWindow(win->handle);
            MessageBox(NULL, L"Failed to create the initial rendering context!", windowName, MB_ICONERROR);
            return nullptr;
        }

        wglMakeCurrent(hdc, tempContext);

        // Load WGL Extensions
        //
        gladLoaderLoadWGL(hdc);

        // Set the desired OpenGL version:
        //
        int attributes[] = 
        {
            WGL_CONTEXT_MAJOR_VERSION_ARB, 4,        // Set the MAJOR version of OpenGL to 3
            WGL_CONTEXT_MINOR_VERSION_ARB, 2,        // Set the MINOR version of OpenGL to 2
            WGL_CONTEXT_FLAGS_ARB,
            WGL_CONTEXT_FORWARD_COMPATIBLE_BIT_ARB,  // Set OpenGL context to be forward compatible
            0
        };

        // Create the final opengl context and get rid of the temporary one
        //
        HGLRC openglContext = NULL;
        if (NULL == (openglContext = wglCreateContextAttribsARB(hdc, NULL, attributes))) 
        {
            wglDeleteContext(tempContext);
            ReleaseDC(win->handle, hdc);
            DestroyWindow(win->handle);
            MessageBox(NULL, L"Failed to create the final rendering context!", windowName, MB_ICONERROR);
            return nullptr;
        }
        wglMakeCurrent(NULL, NULL);         // Remove the temporary context from being active
        wglDeleteContext(tempContext);      // Delete the temporary OpenGL context
        wglMakeCurrent(hdc, openglContext); // Make OpenGL 4.6 context current

        // Glad Loader
        //
        if (!gladLoaderLoadGL()) 
        {
            wglMakeCurrent(NULL, NULL);
            wglDeleteContext(openglContext);
            ReleaseDC(win->handle, hdc);
            DestroyWindow(win->handle);
            MessageBox(NULL, L"Glad Loader failed!", windowName, MB_ICONERROR);
            return nullptr;
        }

        // VSYNC
        //
        
        win->hdc = hdc;
    }
    
    AddMenus(win);    
    
    ShowWindow(win->handle, SW_SHOW);
    UpdateWindow(win->handle);
    
    return win;
}

bool fPlatform_Window_Win32::IsOpen(Window*& window)
{
    return window->state;
}

void fPlatform_Window_Win32::SwapBuffers(Window*& window)
{
    
    SwapBuffers(window->hdc);
}

bool fPlatform_Window_Win32::Destroy(Window*& window)
{    
    ReleaseDC(window->handle, window->hdc);
    return DestroyWindow(window->handle);
}

Vec2 fPlatform_Window_Win32::GetWindowPosition(HWND hwnd)
{    
    RECT rc{};
    GetWindowRect(hwnd, &rc);            
    return { (float)rc.left, (float)rc.top };
}

Vec2 fPlatform_Window_Win32::GetWindowDimensions(HWND hwnd)
{
    RECT rc{};
    GetWindowRect(hwnd, &rc);

    return { (float)(rc.right - rc.left), (float)(rc.bottom - rc.top) };
}

Vec2 fPlatform_Window_Win32::GetClientAreaDimensions(HWND hwnd)
{
    RECT rc{};
    GetClientRect(hwnd, &rc);

    return { (float)(rc.right - rc.left), (float)(rc.bottom - rc.top) };
}

void fPlatform_Window_Win32::Internal::AdjustWindowPositionAndDimensions(Window*& window, WINDOW_STATE windowState)
{
    switch (windowState)
    {
        case WINDOW_MAXIMIZED: { ShowWindow(window->handle, SW_MAXIMIZE);    } break;
        case WINDOW_MINIMIZED: { ShowWindow(window->handle, SW_MINIMIZE);    } break;
        case WINDOW_OPEN:      { ShowWindow(window->handle, SW_SHOWDEFAULT); } break;
    }


    window->state                = windowState;
    window->position             = GetWindowPosition(window->handle);
    window->dimensions           = GetWindowDimensions(window->handle);
    window->clientAreaDimensions = GetClientAreaDimensions(window->handle);       
}

    

void fPlatform_Input_Win32::Initialize()
{           
    // =======================================
    // Controler HID
    // =======================================
    RAWINPUTDEVICE controller{};
    controller.usUsagePage = HID_USAGE_PAGE_GENERIC;
    controller.usUsage     = HID_USAGE_GENERIC_GAMEPAD;               
    controller.dwFlags     = 0;                 
    controller.hwndTarget  = 0;

    // =======================================
    // Keyboard
    // =======================================
    if (RegisterRawInputDevices(&controller, 1, sizeof(controller)) == FALSE) { printf("Error - Failed to register RawInputDevice\n"); }

    Internal::keyboardHook = SetWindowsHookEx(WH_KEYBOARD_LL, Internal::LowLevelKeyboardProc, NULL, 0);
}

void fPlatform_Input_Win32::Update(Window*& win)
{     
    Internal::UpdateMouse(win); 
    if (GetActiveWindow() == win->handle) { Internal::UpdateKeys();       }
    else                                  { fInput::ClearAllInputState(); }    
}   


void fPlatform_Input_Win32::Internal::UpdateController(const unsigned char *data, const unsigned int size)
{
    // Documentation in the logbook file
    // 
    // =============================================================
    //                      PS5 Controller Scheme
    // =============================================================
    // 
    // Left Joystick
    //
    float leftJoystickX = (data[1] - 128.0f) /  128.0f;
    float leftJoystickY = (data[2] - 128.0f) / -128.0f;
    Controller::JOYSTICK_LEFT = { leftJoystickX, leftJoystickY };
    //
    // Right Joystick
    //
    float rightJoystickX = (data[3] - 128.0f) /  128.0f;
    float rightJoystickY = (data[4] - 128.0f) / -128.0f;
    Controller::JOYSTICK_RIGHT = { rightJoystickX , rightJoystickY };
    //
    // Range L2 & R2
    //
    Controller::RANGE_L2 = data[5] / 255.0f;
    Controller::RANGE_R2 = data[6] / 255.0f;
    //
    // DPad
    //        
    Controller::DPAD_UP    = ((data[8] & 0b00001111) == 0) | ((data[8] & 0b00001111) == 1) | ((data[8] & 0b00001111) == 7);
    Controller::DPAD_RIGHT = ((data[8] & 0b00000111) == 1) | ((data[8] & 0b00000111) == 2) | ((data[8] & 0b00000111) == 3);
    Controller::DPAD_DOWN  = ((data[8] & 0b00000111) == 3) | ((data[8] & 0b00000111) == 4) | ((data[8] & 0b00000111) == 5);
    Controller::DPAD_LEFT  = ((data[8] & 0b00000111) == 5) | ((data[8] & 0b00000111) == 6) | ((data[8] & 0b00000111) == 7);
    //
    // Square Ex Circle Triangle 
    //
    Controller::BUTTON_SQUARE   = (data[8] & 0b00010000) == 16;
    Controller::BUTTON_EX       = (data[8] & 0b00100000) == 32;
    Controller::BUTTON_CIRCLE   = (data[8] & 0b01000000) == 64;
    Controller::BUTTON_TRIANGLE = (data[8] & 0b10000000) == 128;
    //
    // L1 R1 Button L2 Button R2 Select Start L3 R3
    //
    Controller::BUTTON_L1     = (data[9] & 0b00000001);
    Controller::BUTTON_R1     = (data[9] & 0b00000010) == 2;
    Controller::BUTTON_L2     = (data[9] & 0b00000100) == 4;
    Controller::BUTTON_R2     = (data[9] & 0b00001000) == 8;
    Controller::BUTTON_SELECT = (data[9] & 0b00010000) == 16;
    Controller::BUTTON_START  = (data[9] & 0b00100000) == 32;
    Controller::BUTTON_L3     = (data[9] & 0b01000000) == 64;
    Controller::BUTTON_R3     = (data[9] & 0b10000000) == 128;
    //
    // PS Home Touchpad Button Button Below PS Home // @note This one might contain more data
    // 
    Controller::BUTTON_PS_HOME    = (data[10] & 0b10000001);
    Controller::BUTTON_TOUCHPAD   = (data[10] & 0b00000010) == 2;
    Controller::BUTTON_MICROPHONE = (data[10] & 0b00000100) == 4;
            

          
}

