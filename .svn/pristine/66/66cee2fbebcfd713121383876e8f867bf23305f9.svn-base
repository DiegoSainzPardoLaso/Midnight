void fPlatform_Input_Win32::update_after_each_frame()
{
    // Keys
    for (size_t i = 0; i < KEY_COUNT; i++)
    {
        Input::Internal::firstKeyPress[i] = Input::Internal::keys[i];
    }

    // Mouse
    Mouse::Internal::BUTTON_LEFT_FIRST_PRESS         = Mouse::BUTTON_LEFT;
    Mouse::Internal::BUTTON_RIGHT_FIRST_PRESS        = Mouse::BUTTON_RIGHT;
    Mouse::Internal::BUTTON_SCROLL_WHEEL_FIRST_PRESS = Mouse::BUTTON_SCROLL_WHEEL;
}

void fPlatform_Input_Win32::Terminate()
{
    UnhookWindowsHookEx(Internal::keyboardHook);
    Internal::keyboardHook = nullptr;
}



Vec2 fPlatform_Win32::UpdateVirtualScreenDimensions()
{
    Internal::VIRTUAL_SCREEN_WIDTH  = GetSystemMetrics(SM_CXVIRTUALSCREEN);
    Internal::VIRTUAL_SCREEN_HEIGHT = GetSystemMetrics(SM_CYVIRTUALSCREEN);
    
    return { (float)Internal::VIRTUAL_SCREEN_WIDTH, (float)Internal::VIRTUAL_SCREEN_HEIGHT };
}

Vec2 fPlatform_Win32::GetScreenResolution(HWND handle)
{           
    HMONITOR monitor = MonitorFromWindow(handle, MONITOR_DEFAULTTONEAREST);
    MONITORINFO monitorInfo{};
    monitorInfo.cbSize = sizeof(MONITORINFO);
    GetMonitorInfoW(monitor, &monitorInfo);    

    return { (float)(monitorInfo.rcMonitor.right - monitorInfo.rcMonitor.left), (float)(monitorInfo.rcMonitor.bottom - monitorInfo.rcMonitor.top) };    
}

Vec4 fPlatform_Win32::UpdateCurrentMonitorVirtualScreenCoordinates(HWND handle)
{
    HMONITOR monitor = MonitorFromWindow(handle, MONITOR_DEFAULTTONEAREST);
    MONITORINFO monitorInfo{};
    monitorInfo.cbSize = sizeof(MONITORINFO);
    GetMonitorInfoW(monitor, &monitorInfo);
  
    Internal::CURRENT_MONITOR_VIRTUAL_X  = monitorInfo.rcWork.left;
    Internal::CURRENT_MONITOR_VIRTUAL_Y  = monitorInfo.rcWork.top;
    Internal::CURRENT_MONITOR_VIRTUAL_CX = monitorInfo.rcWork.right;
    Internal::CURRENT_MONITOR_VIRTUAL_CY = monitorInfo.rcWork.bottom;    
    
    

    return { (float)monitorInfo.rcWork.left, (float)monitorInfo.rcWork.top, (float)monitorInfo.rcWork.right, (float)monitorInfo.rcWork.bottom };
}





void AddMenus(Window*& win) 
{
    win->menuBar = CreateMenu();   
    
    COLORREF cr  = MENU_BAR_COLOR;
    HBRUSH brush = CreateSolidBrush(cr);
    
    MENUINFO menuInfo{};
    menuInfo.cbSize  = sizeof(MENUINFO);
    menuInfo.fMask   = MIM_BACKGROUND;    
    menuInfo.hbrBack = brush;
    SetMenuInfo(win->menuBar, &menuInfo);
    

    AppendMenu(win->menuBar, MF_STRING, NULL, L"Project");
    
    // ========================================================================
    // ========================================================================

    HMENU sceneMenu = CreateMenu();
        
        AppendMenu(sceneMenu, MF_STRING,    MI_SCENE_NEW,  L"New Scene");

        AppendMenu(sceneMenu, MF_SEPARATOR, NULL,          NULL);
        AppendMenu(sceneMenu, MF_STRING,    MI_SCENE_SAVE, L"Save Scene");
        AppendMenu(sceneMenu, MF_STRING,    MI_SCENE_LOAD, L"Load Scene");

    AppendMenu(win->menuBar, MF_POPUP, (UINT_PTR)sceneMenu, L"Scene");
    
    // ========================================================================
    // ========================================================================

    HMENU editMenu = CreateMenu();
        
        AppendMenu(editMenu, MF_STRING,    MI_EDIT_UNDO,  L"Undo");
        AppendMenu(editMenu, MF_STRING,    MI_EDIT_REDO,  L"Redo");        
        AppendMenu(editMenu, MF_SEPARATOR, NULL,          NULL);
        AppendMenu(editMenu, MF_STRING,    MI_EDIT_QUIT,  L"Quit");
    
    AppendMenu(win->menuBar, MF_POPUP, (UINT_PTR)editMenu, L"Editor");

    // ========================================================================
    // ========================================================================



    AppendMenu(win->menuBar, MF_STRING, NULL,    L"Help");
    
    // Used so I can change the background color    
    //
    AppendMenu(win->menuBar, MF_OWNERDRAW, 4, L"");

    SetMenu(win->handle, win->menuBar);                
}

bool OpenFileExplorer(char *outPath, FileExplorerMode mode)
{         
    OPENFILENAME ofn;
    
    char szFileName[MAX_PATH] = "";
    
    ZeroMemory(&ofn, sizeof(ofn));
    
    ofn.lStructSize = sizeof(ofn);
    ofn.hwndOwner	= NULL;
    ofn.lpstrFilter = (LPCWSTR)L"Midnight Text Scene (*.mits)\0*.mits\0Midnight Binary Scene (*.mibs*)\0*.mibs*\0";
    ofn.lpstrFile	= (LPWSTR)szFileName;
    ofn.nMaxFile	= MAX_PATH;
    ofn.Flags		= OFN_EXPLORER | OFN_FILEMUSTEXIST | OFN_HIDEREADONLY;
    ofn.lpstrDefExt = (LPCWSTR)L"mits";
    
    switch (mode)
    {
        case NEW:  
        {
            ofn.lpstrTitle = L"New Scene";  
            GetSaveFileName(&ofn);

        }break;
        case SAVE: 
        {
            ofn.lpstrTitle = L"Save Scene"; 
            GetSaveFileName(&ofn);
        }break;
        case OPEN: 
        {
            ofn.lpstrTitle = L"Load Scene"; 
            GetOpenFileName(&ofn);
        }break;

        default: { std::cout << "Error - Unidentified Explorer Mode\n"; }break;
    }    
    
    char fPath[MAX_PATH];
    WideCharToMultiByte(CP_ACP, WC_COMPOSITECHECK, ofn.lpstrFile, -1, fPath, MAX_PATH, NULL, NULL);
    int sizeOfPath = (int)wcslen(ofn.lpstrFile);
    
    if (sizeOfPath <= 0) 
    {
        return false; 
    }
    
    strcpy(outPath, fPath);

    return true;
}