#include "Engine.h"


void Midnight::Engine::Run()
{

#if CURRENT_RENDERING_API == VULKAN

    Time::Initialize();
    fPlatform_Input_Win32::Initialize();
    
    core               = new MidnightEngineCore();
    core->mainWindow   = fPlatform_Window_Win32::Create(100, 100, WIDTH, HEIGHT, "Midnight Engine");
    core->cameraSystem = fCameraSystem::Initialize();
    
    fScene::DefaultScene(core->cameraSystem);
    fVulkan::Initialize(core->mainWindow->handle, core->mainWindow->clientAreaDimensions, core->renderNodesVulkan, core->cameraSystem);
        



    auto chronoCurrentFrameTime = std::chrono::high_resolution_clock::now();
    auto chronoLastFrameTime	= chronoCurrentFrameTime;
    auto currentDelta		    = std::chrono::duration<float, std::chrono::seconds::period>(chronoCurrentFrameTime - chronoLastFrameTime).count();

    

    while (fPlatform_Window_Win32::IsOpen(core->mainWindow))
    {
        fPlatform_Window_Win32::UpdateMessageLoop(core->mainWindow->handle);
        fPlatform_Window_Win32::UpdateCustomEvents(core->mainWindow);
        fPlatform_Input_Win32 ::Update(core->mainWindow);
        fPlatform_Window_Win32::UpdateWindowShortcuts(core->mainWindow);

        fVulkan::RecreationFunctionalities(core->mainWindow->clientAreaDimensions);

        std::string time = "Midnight Engine - FPS: " + std::to_string(Time::FPS()) + " | ms: " + std::to_string(Time::DeltaTime());
        fPlatform_Window_Win32::UpdateWindowTitle(core->mainWindow, time.data());

        if (VSYNC)
        {
            chronoCurrentFrameTime = std::chrono::high_resolution_clock::now();                                  
            Time::UpdateDeltaTimeVSYNC(currentDelta); // @note That the first frame will have wrong values
                        
            //=========================================================================================================================//
            // Main Engine Systems
            //=========================================================================================================================// 

            fCameraSystem::Update(core->cameraSystem, core->mainWindow->clientAreaDimensions);
            
            static float a = 0;
            a += 60 * Time::DeltaTime();
            Quat q = CreateQuaternionFromAxisAndAngle(a, 0, 0, 1);

            fTransform::UpdateOrientation(core->cameraSystem->cameras[0].transform, q);

            //=========================================================================================================================//
            // Drawing
            //=========================================================================================================================//

            fVulkan::Draw(core->renderNodesVulkan, core->cameraSystem->activeCamera, core->mainWindow->clientAreaDimensions );

            //=========================================================================================================================//
            // Platform Specific things that have to happend inside the framae
            //=========================================================================================================================//

            fPlatform_Input_Win32::UpdateAfterEachFrame();

            //=========================================================================================================================//

            currentDelta        = std::chrono::duration<float, std::chrono::seconds::period>(chronoCurrentFrameTime - chronoLastFrameTime).count();
            chronoLastFrameTime = chronoCurrentFrameTime;                            

            if (currentDelta < 1 / MAX_FPS)
            {
                float ms = 1 / MAX_FPS - currentDelta;     
                // printf("Slept for %f ms\n", ms); 
                // Sleep(ms);
            }
        }

    }

        
    fVulkan::CleanUp(core->renderNodesVulkan);

#else
    Initialize();
    Update();
    Terminate();
#endif
}




#if CURRENT_RENDERING_API == OPENGL

void Midnight::Engine::Initialize()
{
    Time::Initialize();
    fPlatform_Input_Win32::Initialize();

    core                           = new MidnightEngineCore();
    core->mainWindow               = fPlatform_Window_Win32::Create(100, 100, 1920, 1080, "Midnight Engine");
    core->cameraSystem             = fCameraSystem::Initialize();
    core->console                  = fConsole::Initialize();
    core->grid                     = fGrid::Initialize();        
    core->gizmos                   = fGizmos::Initialize(core->mainWindow->clientAreaDimensions);
    
    fScene::DefaultScene(core->cameraSystem);


    core->renderNodesOGL = fRenderableObjectsManager::Initialize(core->cameraSystem);
    fRenderer::Initialize();        
}


void Midnight::Engine::Update()
{

    auto chronoCurrentFrameTime = std::chrono::high_resolution_clock::now();
    auto chronoLastFrameTime	= chronoCurrentFrameTime;
    auto currentDelta		    = std::chrono::duration<float, std::chrono::seconds::period>(chronoCurrentFrameTime - chronoLastFrameTime).count();
    

    while (fPlatform_Window_Win32::IsOpen(core->mainWindow))
    {
        fPlatform_Window_Win32::UpdateMessageLoop(core->mainWindow->handle);
        fPlatform_Window_Win32::UpdateCustomEvents(core->mainWindow);
        fPlatform_Input_Win32::Update(core->mainWindow);
        fPlatform_Window_Win32::UpdateWindowShortcuts(core->mainWindow);

        fScene::Update(fPlatform_Win32::InterestValues::SCENE_SAVE_PATH, fPlatform_Win32::InterestValues::SCENE_MUST_BE_SAVED, fPlatform_Win32::InterestValues::SCENE_LOAD_PATH, fPlatform_Win32::InterestValues::SCENE_MUST_BE_LOADED, core->cameraSystem);

        if (VSYNC)
        {
            chronoCurrentFrameTime = std::chrono::high_resolution_clock::now();
            Time::UpdateDeltaTimeVSYNC(currentDelta);
            
            std::string windowTitle = "Midnight Engine - " + std::to_string(Time::FPS()) + " fps";
            fPlatform_Window_Win32::UpdateWindowTitle(core->mainWindow, windowTitle.data());

            fViewport::Update(core->mainWindow->clientAreaDimensions);            
            fGizmos::Update(core->gizmos, core->renderNodesOGL, core->cameraSystem, core->mainWindow->clientAreaDimensions);


            fCameraSystem::Update(core->cameraSystem, core->mainWindow->clientAreaDimensions);
            fConsole::Update(core->console, core->mainWindow->clientAreaDimensions);
            fMGUI::Update();
            fGrid::Update(core->grid);
            EntityManager::Update();
        
            // I need to have a recolection of all shaders in the same place, and every object should have a reference to it unless stated other way???
            // The vulkan approach is way better and way sturdier than this... When I manage to fix the Push constant ranges, and implement the picker in 
            // vk, I think I'm gonna left the OGL implementation behind... we'll see.
            fRenderableObjectsManager::Update(core->renderNodesOGL);


            static float angle = 0;
            angle += 60 * Time::DeltaTime();
            Quat q = CreateQuaternionFromAxisAndAngle(angle, 0, 0, 1);

            fTransform::UpdateOrientation(core->cameraSystem->cameras[0].transform, q);

                    
            fRenderer::Draw
            (
                core->mainWindow->clientAreaDimensions, 
                core->cameraSystem, 
                core->console, 
                core->grid, 
                core->gizmos,
                core->renderNodesOGL
            );
                           
            fPlatform_Window_Win32::SwapBuffers(core->mainWindow);

            fPlatform_Input_Win32::UpdateAfterEachFrame();


            currentDelta        = std::chrono::duration<float, std::chrono::seconds::period>(chronoCurrentFrameTime - chronoLastFrameTime).count();
            chronoLastFrameTime = chronoCurrentFrameTime;                            

            if (currentDelta < 1 / MAX_FPS)
            {
                float ms = 1 / MAX_FPS - currentDelta;     
                // printf("Slept for %f ms\n", ms); 
                // Sleep(ms);
            }

            
        }

    }    
}


void Midnight::Engine::Terminate()
{
    fPlatform_Input_Win32::Terminate();
    fPlatform_Window_Win32::Destroy(core->mainWindow);

	free(core->mainWindow);	
    free(core);
}


#endif