#include "Platform.h"

#ifdef _WIN32

void fPlatform::initialize()
{
    fPlatform_Input_Win32::Initialize();
}

void fPlatform::update(Window *&window)
{
    fPlatform_Window_Win32::update_message_loop(window->handle);
    fPlatform_Window_Win32::update_custom_events(window);
    fPlatform_Input_Win32 ::Update(window);
    fPlatform_Window_Win32::update_window_shortcuts(window);
}

void fPlatform::end_of_the_frame_update()
{
    fPlatform_Input_Win32::update_after_each_frame();
}


Window *fPlatform::create_window(int x, int y, int width, int height, const char *window_name)
{
    return fPlatform_Window_Win32::Create(x, y, width, height, window_name);
}

bool fPlatform::is_open(Window *&window)
{
    return fPlatform_Window_Win32::IsOpen(window);
}

bool fPlatform::destroy(Window *&window)
{
    return fPlatform_Window_Win32::Destroy(window);
}

void fPlatform::change_window_title(Window *&window, const char *new_window_name)
{
    fPlatform_Window_Win32::UpdateWindowTitle(window, new_window_name);
}

#endif