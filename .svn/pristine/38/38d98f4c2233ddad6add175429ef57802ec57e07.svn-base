#pragma once

#include <iostream>

#define OUT_RESET      "\x1b[0m"
#define OUT_BOLD       "\x1b[1m"
#define OUT_DIM		   "\x1b[2m"
#define OUT_CURSIVE    "\x1b[3m"
#define OUT_UNDERSCORE "\x1b[4m"
#define OUT_BLINK	   "\x1b[5m"
#define OUT_REVERSE	   "\x1b[7m"

#define OUT_RED		   "\x1b[31m"
#define OUT_GREEN	   "\x1b[32m"
#define OUT_YELLOW	   "\x1b[33m"
#define OUT_BLUE	   "\x1b[34m"
#define OUT_MAGENTA	   "\x1b[35m"
#define OUT_CYAN	   "\x1b[36m"
#define OUT_WHITE	   "\x1b[37m"

#define OUT_BGBLACK    "\x1b[40m"
#define OUT_BGRED	   "\x1b[41m"
#define OUT_BGGREEN    "\x1b[42m"
#define OUT_BGYELLOW   "\x1b[43m"
#define OUT_BGBLUE     "\x1b[44m"
#define OUT_BGMAGENTA  "\x1b[45m"
#define OUT_BGCYAN	   "\x1b[46m"
#define OUT_BGWHITE    "\x1b[47m"


namespace Message
{
	void Info(const char* str);
	void Info(const char* str, const char* fileName);
	void Error(const char* str);
	void Error(const char* str, const char* fileName);
	void Warning(const char* str);
	void Warning(const char* str, const char* fileName);
}