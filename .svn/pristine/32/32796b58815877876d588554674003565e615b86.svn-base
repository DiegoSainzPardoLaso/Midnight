#pragma once

#include <glad/gl.h>

#include "../../Math/Matrix.h"
#include "../../Types/Vertex.h"

namespace OGL_Util
{
	enum Integrants 
	{
		POSITION_COLOR_NORMALS_UV_JOINTIDX_WEIGHTS,	// 19 Component stride [76 bytes]
		POSITION_COLOR_NORMALS_UV,					// 11 Component stride [44 bytes]
		POSITION_COLOR_NORMALS,						//  9 Component stride [36 bytes]
		POSITION_COLOR_UV,							//  8 Component stride [32 bytes]
        POSITION_COLOR,                             //  6 Component stride [24 bytes]
		POSITION_UV,								//  5 Component stride [20 bytes]
	};

	template<typename VertexType>
    void Create_VAO_VBO_EBO(int& index, unsigned int& VAO, unsigned int& VBO, unsigned int& EBO, VertexType* data, int dSize, int* indices, int iSize, Integrants integrants, GLenum usage)
    {
        // @note Default case, Position, Colors, Normals, UV's Joints idx and weights [ Animated Model ]

        int strideLength     = 19;
        int shdrLayoutIdx[6] = { 0, 1, 2, 3,  4,  5 };
        int strideOffsets[6] = { 0, 3, 6, 9, 11, 15 };

        switch (integrants)
        {
            case POSITION_COLOR_NORMALS_UV:
            {
                strideLength     = 11;

                shdrLayoutIdx[0] =  0;      // @note    Position  
                shdrLayoutIdx[1] =  1;      // @note    Color
                shdrLayoutIdx[2] =  2;      // @note    Normal
                shdrLayoutIdx[3] =  3;      // @note    UV
                shdrLayoutIdx[4] = -9;      // @warning NON VALID
                shdrLayoutIdx[5] = -9;      // @warning NON VALID

                strideOffsets[0] =  0;      // @note    Position Offset  
                strideOffsets[1] =  3;      // @note    Color    Offset
                strideOffsets[2] =  6;      // @note    Normal   Offset
                strideOffsets[3] =  9;      // @note    UV       Offset
                strideOffsets[4] = -9;      // @warning NON VALID
                strideOffsets[5] = -9;      // @warning NON VALID

            } break;

            case POSITION_COLOR_NORMALS:
            {
                strideLength     =  9;

                shdrLayoutIdx[0] =  0;      // @note    Position
                shdrLayoutIdx[1] =  1;      // @note    Color
                shdrLayoutIdx[2] =  2;      // @note    Normal
                shdrLayoutIdx[3] = -9;      // @warning NON VALID
                shdrLayoutIdx[4] = -9;      // @warning NON VALID
                shdrLayoutIdx[5] = -9;      // @warning NON VALID

                strideOffsets[0] =  0;      // @note    Position Offset
                strideOffsets[1] =  3;      // @note    UV       Offset
                strideOffsets[2] =  6;      // @note    Normal   Offset
                strideOffsets[3] = -9;      // @warning NON VALID
                strideOffsets[4] = -9;      // @warning NON VALID
                strideOffsets[5] = -9;      // @warning NON VALID

            } break;

            case POSITION_COLOR_UV:
            {
                strideLength     =  8;

                shdrLayoutIdx[0] =  0;      // @note    Position
                shdrLayoutIdx[1] =  1;      // @note    Color      
                shdrLayoutIdx[2] = -9;      // @warning NON VALID
                shdrLayoutIdx[3] =  2;      // @note    UV
                shdrLayoutIdx[4] = -9;      // @warning NON VALID
                shdrLayoutIdx[5] = -9;      // @warning NON VALID

                strideOffsets[0] =  0;      // @note    Position Offset
                strideOffsets[1] =  3;      // @note    Color Offset
                strideOffsets[2] = -9;      // @warning NON VALID
                strideOffsets[3] =  6;      // @note    UV Offset
                strideOffsets[4] = -9;      // @warning NON VALID
                strideOffsets[5] = -9;      // @warning NON VALID

            } break;

            case POSITION_UV:
            {
                strideLength     =  5;

                shdrLayoutIdx[0] =  0;      // @note    Position
                shdrLayoutIdx[1] = -9;      // @warning NON VALID
                shdrLayoutIdx[2] = -9;      // @warning NON VALID
                shdrLayoutIdx[3] =  1;      // @note    UV   
                shdrLayoutIdx[4] = -9;      // @warning NON VALID
                shdrLayoutIdx[5] = -9;      // @warning NON VALID

                strideOffsets[0] =  0;      // @note    Position Offset
                strideOffsets[1] = -9;      // @warning NON VALID
                strideOffsets[2] = -9;      // @warning NON VALID
                strideOffsets[3] =  3;      // @note    UV Offset
                strideOffsets[4] = -9;      // @warning NON VALID
                strideOffsets[5] = -9;      // @warning NON VALID

            } break;
        }

        glGenVertexArrays(1, &VAO);
        glGenBuffers(1, &VBO);
        glGenBuffers(1, &EBO);

        glBindVertexArray(VAO);

        glBindBuffer(GL_ARRAY_BUFFER, VBO);
        glBufferData(GL_ARRAY_BUFFER, dSize * sizeof(float), data, usage);
        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, EBO);
        glBufferData(GL_ELEMENT_ARRAY_BUFFER, iSize * sizeof(int), indices, usage);

        // @note The 5th argument is the size of the complete stride. pos (3) + color (3) + normals (3) + uv (2)
        // Position
        glEnableVertexAttribArray(shdrLayoutIdx[0]);
        glVertexAttribPointer(shdrLayoutIdx[0], 3, GL_FLOAT, GL_FALSE, strideLength * sizeof(float), (void*)(sizeof(float) * strideOffsets[0]));

        // Color
        //
        if (integrants == Integrants::POSITION_COLOR_NORMALS_UV || integrants == Integrants::POSITION_COLOR_NORMALS || integrants == Integrants::POSITION_COLOR_UV || integrants == Integrants::POSITION_COLOR_NORMALS_UV_JOINTIDX_WEIGHTS)
        {
            glEnableVertexAttribArray(shdrLayoutIdx[1]);
            glVertexAttribPointer(shdrLayoutIdx[1], 3, GL_FLOAT, GL_FALSE, strideLength * sizeof(float), (void*)(sizeof(float) * strideOffsets[1]));
        }

        // Normal
        //
        if (integrants == Integrants::POSITION_COLOR_NORMALS_UV || integrants == Integrants::POSITION_COLOR_NORMALS || integrants == Integrants::POSITION_COLOR_NORMALS_UV_JOINTIDX_WEIGHTS)
        {
            glEnableVertexAttribArray(shdrLayoutIdx[2]);
            glVertexAttribPointer(shdrLayoutIdx[2], 3, GL_FLOAT, GL_FALSE, strideLength * sizeof(float), (void*)(sizeof(float) * strideOffsets[2]));
        }

        // UV Coords
        //
        if (integrants == Integrants::POSITION_COLOR_NORMALS_UV || integrants == Integrants::POSITION_COLOR_UV || integrants == Integrants::POSITION_UV || integrants == Integrants::POSITION_COLOR_NORMALS_UV_JOINTIDX_WEIGHTS)
        {
            glEnableVertexAttribArray(shdrLayoutIdx[3]);
            glVertexAttribPointer(shdrLayoutIdx[3], 2, GL_FLOAT, GL_FALSE, strideLength * sizeof(float), (void*)(sizeof(float) * strideOffsets[3]));
        }

        // Joint IDs and Weights
        //
        if (integrants == Integrants::POSITION_COLOR_NORMALS_UV_JOINTIDX_WEIGHTS)
        {
            // Joint Idx
            //
            // @important // @note If i want to pass integers, I need to use glVertexAttribIPointer instead of the regular glVertexAttribPointer
            glEnableVertexAttribArray(shdrLayoutIdx[4]);
            glVertexAttribIPointer(shdrLayoutIdx[4], 4, GL_INT, strideLength * sizeof(int), (void*)(sizeof(int) * strideOffsets[4]));

            // Weights
            //
            glEnableVertexAttribArray(shdrLayoutIdx[5]);
            glVertexAttribPointer(shdrLayoutIdx[5], 4, GL_FLOAT, GL_FALSE, strideLength * sizeof(float), (void*)(sizeof(float) * strideOffsets[5]));
        }

        glBindBuffer(GL_ARRAY_BUFFER, index);
        glBindVertexArray(index);
    }

    template<typename VertexType>
    void UpdateVBO(GLenum target, int dSize, unsigned int VBO, VertexType*& data, GLenum usage)
    {
        glBindBuffer(target, VBO);
        glBufferData(target, dSize, data, usage);
    }

    // @note This one is for DrawElements calls
    //
    void Create_Line_VAO_VBO(int& index, unsigned int& VAO, unsigned int& VBO, dVertex*& data, int dSize, GLenum usage);

    void CreateDebugObject_VAO_VBO_EBO(int& index, unsigned int& VAO, unsigned int& VBO, unsigned int& EBO, dVertex*& data, int dSize, int*& indices, int iSize, GLenum usage);
	
}