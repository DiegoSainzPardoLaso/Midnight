#include "MAFLoader.h"

Animation MAFLoader::LoadAnimation(const char* path)
{
	if (tFile::CompareExtension(path, __MAF__)) { return Internal::LoadBinary(path); }
	if (tFile::CompareExtension(path, __MAFT__))  { return Internal::LoadASCII(path); }

	return Animation{};
};

Animation MAFLoader::Internal::LoadBinary(const char* path)
{
	std::ifstream file(path, std::ios::in | std::ios::binary);
	Animation	  animation{};
	char*	      date = nullptr;
	char*		  kind = nullptr;

	date                 = bFile::ReadString(file);
	animation.name       = bFile::ReadString(file);
	kind				 = bFile::ReadString(file);

	if (fUtil::CompareCharArrayWithStringLiteral(kind, "raw")) { animation.transformType = AnimationTransformType::Raw;			}
	else													  {	animation.transformType = AnimationTransformType::Hierarchical; }

	animation.frameCount = bFile::ReadInt(file);
	animation.frameRate  = bFile::ReadFloat(file);
	animation.jointCount = bFile::ReadInt(file);

	if (animation.jointCount <= 0)
	{
		const char* fileName = tFile::GetName(path);
		Message::Error("Animation Load Failed. No joints found. Returning empty animation", fileName);
		return Animation{};
	}

	if (animation.frameCount <= 0)
	{
		const char* fileName = tFile::GetName(path);
		Message::Error("Animation Load Failed. No frames found. Returning empty animation", fileName);
		return Animation{};
	}

	animation.keyFrames = reinterpret_cast<Keyframe*>(malloc(sizeof(Keyframe) * animation.frameCount));

	for (unsigned int frameIdx = 0; frameIdx < animation.frameCount; frameIdx++)
	{
		animation.keyFrames[frameIdx].timeStamp   = (float)frameIdx;
		animation.keyFrames[frameIdx].jointsCount = animation.jointCount;
		animation.keyFrames[frameIdx].position    = reinterpret_cast<Vec3*>(malloc(sizeof(Vec3) * animation.jointCount));
		animation.keyFrames[frameIdx].orientation = reinterpret_cast<Quat*>(malloc(sizeof(Quat) * animation.jointCount));
		animation.keyFrames[frameIdx].scale       = reinterpret_cast<Vec3*>(malloc(sizeof(Vec3) * animation.jointCount));
		animation.keyFrames[frameIdx].transform   = reinterpret_cast<Mat4*>(malloc(sizeof(Mat4) * animation.jointCount));

		for (unsigned int jointIdx = 0; jointIdx < animation.jointCount; jointIdx++)
		{
			animation.keyFrames[frameIdx].position[jointIdx]    = bFile::ReadSizeOf<Vec3>(file);
			animation.keyFrames[frameIdx].orientation[jointIdx] = bFile::ReadSizeOf<Quat>(file);
			animation.keyFrames[frameIdx].scale[jointIdx]       = bFile::ReadSizeOf<Vec3>(file);
			animation.keyFrames[frameIdx].transform[jointIdx]   = MILA::BuildModelSpaceTransform
																(
																	animation.keyFrames[frameIdx].position[jointIdx],
																	animation.keyFrames[frameIdx].orientation[jointIdx],
																	animation.keyFrames[frameIdx].scale[jointIdx]
																);
		}
	}

	return animation;
}

Animation MAFLoader::Internal::LoadASCII(const char* path)
{
	std::ifstream file(path, std::ios::in);

	Animation     animation{};
	std::string   line;
	bool		  readyToStartReadingFrames = false;
	int			  currentFrameIndex = -1;
	int			  currentJointIndex = 0;
	int			  indentationDepth  = 0;

	while (std::getline(file, line))
	{
		std::vector<std::string> tokens = fUtil::TokenizeLine(line, ' ', NULL, NULL);

		if (!tokens[0].compare("name:") && animation.name == nullptr)
		{
			bool startReading = false;
			std::string name = "";
			for (int i = 0; i < line.size(); i++)
			{
				if (line[i] == '\n' || line[i] == '-') { break; }
				if (startReading) { name += line[i]; }
				if (line[i] == ':') { startReading = true; }
			}
			animation.name = reinterpret_cast<char*>(malloc(name.size()));
			strcpy(animation.name, name.data());
		}
		if (!tokens[0].compare("frame") && !tokens[1].compare("count:"))
		{
			animation.frameCount = std::stoi(tokens[2]);
			animation.keyFrames = reinterpret_cast<Keyframe*>(malloc(sizeof(Keyframe) * animation.frameCount));

			if (animation.frameCount <= 0)
			{
				const char* fileName = tFile::GetName(path);
				Message::Error("Animation Load Failed. No frames found. Returning empty animation", fileName);
				return Animation{};
			}

		}
		if (!tokens[0].compare("frame") && !tokens[1].compare("rate:"))  { animation.frameRate  = std::stof(tokens[2]); }
		if (!tokens[0].compare("bone")  && !tokens[1].compare("data:")) 
		{
			if (!tokens[2].compare("raw")) { animation.transformType = AnimationTransformType::Raw;          }
			else						   { animation.transformType = AnimationTransformType::Hierarchical; }
		}
		if (!tokens[0].compare("joint") && !tokens[1].compare("count:")) 
		{
			animation.jointCount = std::stoi(tokens[2]); 
			if (animation.jointCount <= 0)
			{
				const char* fileName = tFile::GetName(path);
				Message::Error("Animation Load Failed. No joints found. Returning empty animation", fileName);
				return Animation{};
			}

			for (unsigned int kf = 0; kf < animation.frameCount; kf++)
			{
				animation.keyFrames[kf].position    = reinterpret_cast<Vec3*>(malloc(sizeof(Vec3) * animation.jointCount));
				animation.keyFrames[kf].orientation = reinterpret_cast<Quat*>(malloc(sizeof(Quat) * animation.jointCount));
				animation.keyFrames[kf].scale       = reinterpret_cast<Vec3*>(malloc(sizeof(Vec3) * animation.jointCount));
				animation.keyFrames[kf].transform   = reinterpret_cast<Mat4*>(malloc(sizeof(Mat4) * animation.jointCount));

				animation.keyFrames[kf].timeStamp   = (float)kf;
				animation.keyFrames[kf].jointsCount = animation.jointCount;
			}

			readyToStartReadingFrames = true; 
		}
		
		if (indentationDepth == 1 && !tokens[0].compare("{"))
		{
			currentFrameIndex++;
			currentJointIndex = 0;
		}
		if (!tokens[0].compare("{")) { indentationDepth++; }
		if (!tokens[0].compare("}"))        
		{
			indentationDepth--; 
			currentJointIndex++;
		}

		if (indentationDepth == 3)
		{
			if (!tokens[0].compare("position:"))    { animation.keyFrames[currentFrameIndex].position[currentJointIndex]    = { std::stof(tokens[1]), std::stof(tokens[2]), std::stof(tokens[3]) };						  }
			if (!tokens[0].compare("orientation:")) { animation.keyFrames[currentFrameIndex].orientation[currentJointIndex] = { std::stof(tokens[1]), std::stof(tokens[2]), std::stof(tokens[3]), std::stof(tokens[4]) }; }
			if (!tokens[0].compare("scale:"))       
			{
				animation.keyFrames[currentFrameIndex].scale[currentJointIndex]     = { std::stof(tokens[1]), std::stof(tokens[2]), std::stof(tokens[3]) };
				animation.keyFrames[currentFrameIndex].transform[currentJointIndex] = MILA::BuildModelSpaceTransform
																							(
																								animation.keyFrames[currentFrameIndex].position[currentJointIndex], 
																								animation.keyFrames[currentFrameIndex].orientation[currentJointIndex], 
																								animation.keyFrames[currentFrameIndex].scale[currentJointIndex]
																							);				
			}
		}		


	}

	return animation;
}