#pragma once

#include "Vertex.h"

// vertices = Mesh vertex array
// indices  = Mesh Indices array
// dSize    = Size in bytes of the complete array (Vertices, Colors, UV's, Normals...
// vCount   = Number of vertices inside the array
// iCount   = Number of indices inside the array
//

template <typename vertexType>
struct Mesh
{
    vertexType *vertices;
    int        *indices;

    uint32_t    dSize;
    uint32_t    vCount;
    uint32_t    iCount;
  
    Mesh(const vertexType *vertices, const int *indices, uint32_t vertexCount, uint32_t indexCount) 
    {        
        this->vCount   = vertexCount;
        this->iCount   = indexCount;
        this->dSize    = sizeof(vertexType) * vertexCount;

        this->vertices = (vertexType *)malloc(sizeof(vertexType) * vertexCount);
        this->indices  = (int        *)malloc(sizeof(int       ) * indexCount );


        for (size_t i = 0; i < this->iCount; i++)
        {
            if (i < this->vCount) { this->vertices[i] = vertices[i]; }
            this->indices[i] = indices[i];
        }
    }
};



