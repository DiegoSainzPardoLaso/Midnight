enum TextType
{
    STATIC_TEXT,
    INPUT_TEXT
};
struct Text
{
    TextType      kind;
    Font          font;
    GUIMesh		  mesh;
    SS_Transform  transform;   // IDENTICAL    

    SS_Transform  virtualCursor;
    GUIMesh		  virtualCursorMesh;

    // TEXT
    int			  id;
    char*         sentence;
    int			  sentenceLength;


    // INPUT TEXT
    char          inputSentence[128];
    int           inptSentChar;

    int			  lineCount;
    float		  lineWidth;
    float	      maxLineWidth;
};
// TEST //    
