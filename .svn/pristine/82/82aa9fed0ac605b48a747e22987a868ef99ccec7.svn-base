enum PanelOptions
{    
    ADJUST_WIDGETS_WIDTHS_AUTOMATICALLY,
    RESIZEABLE,    
};

// #================================================================#
// # Groupings
// #================================================================#

struct GUIWidget
{
    float x;
    float y;
    float width;
    float height;

    Vec3 color;

    GUIMeshQuad geometry;  
};

struct Panel : GUIWidget
{   
    int id;
    float widgetYOffset;
    std::vector<GUIWidget> widgets;
    GUIMeshQuad geometry;
};

// #================================================================#
// # Global GUI State    
// #================================================================#

struct GUIData
{
    std::unordered_map<int, Panel> panels;
};


